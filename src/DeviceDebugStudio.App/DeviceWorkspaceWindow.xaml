<ui:FluentWindow x:Class="DeviceDebugStudio.App.DeviceWorkspaceWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 Title="设备工作区"
                 Icon="Assets/DeviceDebugStudio.ico"
                 Width="340"
                 Height="660"
                 MinWidth="280"
                 MinHeight="420"
                 WindowStartupLocation="Manual"
                 ResizeMode="CanResize"
                 ExtendsContentIntoTitleBar="True">
    <Grid Background="{DynamicResource WorkspaceBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="44" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0"
                     Icon="{ui:SymbolIcon DeveloperBoard24}"
                     Title="{Binding RelativeSource={RelativeSource AncestorType={x:Type ui:FluentWindow}}, Path=Title}" />

        <Grid Grid.Row="1" Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="2,0,2,8">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button Style="{StaticResource IconButtonStyle}"
                        ToolTip="新增设备"
                        Command="{Binding AddProfileCommand}">
                    <ui:SymbolIcon Symbol="Add20" />
                </Button>
                <Button Style="{StaticResource IconButtonStyle}"
                        ToolTip="删除设备"
                        Click="OnDeleteProfileClick">
                    <ui:SymbolIcon Symbol="Delete20" />
                </Button>
            </StackPanel>
            <TextBlock VerticalAlignment="Center"
                       Style="{StaticResource SectionLabelStyle}"
                       FontSize="14"
                       Text="设备工作区" />
        </DockPanel>

        <ListBox x:Name="ProfilesList"
                 Grid.Row="1"
                 ItemsSource="{Binding Profiles}"
                 SelectedItem="{Binding SelectedProfile, Mode=TwoWay}"
                 BorderBrush="{DynamicResource DividerBrush}"
                 BorderThickness="1"
                 Background="{DynamicResource SidebarBackgroundBrush}"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                    <Setter Property="Margin" Value="3,2" />
                    <Setter Property="Padding" Value="4" />
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    <Setter Property="Background" Value="Transparent" />
                    <Setter Property="BorderBrush" Value="Transparent" />
                    <Setter Property="BorderThickness" Value="1" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ListBoxItem">
                                <Border x:Name="ItemBorder"
                                        Background="{TemplateBinding Background}"
                                        BorderBrush="{TemplateBinding BorderBrush}"
                                        BorderThickness="{TemplateBinding BorderThickness}"
                                        CornerRadius="5">
                                    <ContentPresenter />
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource ButtonSurfaceBrush}" />
                                        <Setter TargetName="ItemBorder" Property="BorderBrush" Value="{DynamicResource DividerBrush}" />
                                    </Trigger>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource ButtonSurfaceBrush}" />
                                        <Setter TargetName="ItemBorder" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </ListBox.ItemContainerStyle>
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Grid Margin="3,5">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="28" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Width="24"
                                Height="24"
                                Background="{DynamicResource PanelBackgroundBrush}"
                                CornerRadius="4">
                            <ui:SymbolIcon Foreground="{DynamicResource AccentBrush}" Symbol="UsbPlug20" />
                        </Border>
                        <StackPanel Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Name}"
                                       TextTrimming="CharacterEllipsis"
                                       ToolTip="{Binding Name}" />
                            <TextBlock FontSize="11"
                                       Foreground="{DynamicResource MutedTextBrush}"
                                       Text="{Binding Transport.Kind}" />
                        </StackPanel>
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <Grid Grid.Row="2" Margin="0,10,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <TextBlock Style="{StaticResource SectionLabelStyle}" Text="当前设备名称" />
            <TextBox Grid.Row="1"
                     Margin="0,0,0,7"
                     Style="{StaticResource CompactTextBoxStyle}"
                     Text="{Binding ProfileName, UpdateSourceTrigger=PropertyChanged}" />
            <StackPanel Grid.Row="2">
                <Button x:Name="ProfileActionsButton"
                        Margin="0,0,0,6"
                        Padding="8,6"
                        HorizontalContentAlignment="Left"
                        Click="OnOpenProfileActionsClick">
                    <Button.ContextMenu>
                        <ContextMenu x:Name="ProfileActionsMenu">
                            <MenuItem Header="导入 SSCOM / NetAssist" Click="OnImportLegacyClick" />
                            <Separator />
                            <MenuItem Header="导入设备配置 JSON" Click="OnImportDeviceProfileClick" />
                            <MenuItem Header="导出当前设备 JSON" Click="OnExportDeviceProfileClick" />
                            <Separator />
                            <MenuItem Header="打开捕获数据库" Click="OnOpenCaptureClick" />
                            <Separator />
                            <MenuItem Header="选择配置保存目录" Click="OnConfigureProfileDirectoryClick" />
                        </ContextMenu>
                    </Button.ContextMenu>
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="MoreHorizontal20" />
                        <TextBlock Margin="8,0,0,0" Text="配置操作" />
                    </StackPanel>
                </Button>
                <Button Padding="8,6"
                        HorizontalContentAlignment="Left"
                        Command="{Binding SaveSelectedProfileCommand}">
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="Save20" />
                        <TextBlock Margin="8,0,0,0" Text="保存设备配置" />
                    </StackPanel>
                </Button>
                <TextBlock Margin="2,6,2,0"
                           FontSize="10"
                           Foreground="{DynamicResource MutedTextBrush}"
                           Text="{Binding ProfileDirectory}"
                           TextTrimming="CharacterEllipsis"
                           ToolTip="{Binding ProfileDirectory}" />
            </StackPanel>
        </Grid>
        </Grid>
    </Grid>
</ui:FluentWindow>
