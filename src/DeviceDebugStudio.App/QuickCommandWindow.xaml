<ui:FluentWindow x:Class="DeviceDebugStudio.App.QuickCommandWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 Title="快捷指令"
                 Icon="Assets/DeviceDebugStudio.ico"
                 Width="1080"
                 Height="700"
                 MinWidth="800"
                 MinHeight="480"
                 WindowStartupLocation="Manual"
                 ResizeMode="CanResize"
                 ShowInTaskbar="True"
                 ShowActivated="True"
                 ExtendsContentIntoTitleBar="True">
    <Grid Background="{DynamicResource WorkspaceBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="44" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0"
                     Icon="{ui:SymbolIcon DeveloperBoard24}"
                     Title="{Binding RelativeSource={RelativeSource AncestorType={x:Type ui:FluentWindow}}, Path=Title}" />

        <Grid x:Name="QuickCommandLayoutGrid" Grid.Row="1">
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="QuickCommandListColumn" Width="360" MinWidth="300" MaxWidth="520" />
            <ColumnDefinition Width="8" />
            <ColumnDefinition x:Name="QuickCommandEditorColumn" Width="*" MinWidth="420" />
        </Grid.ColumnDefinitions>

        <Grid Grid.Column="0" Margin="10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <WrapPanel VerticalAlignment="Center">
                <TextBlock Margin="0,0,6,0"
                           VerticalAlignment="Center"
                           Style="{StaticResource SectionLabelStyle}"
                           FontSize="14"
                           Text="快捷指令" />
                <Button Style="{StaticResource IconButtonStyle}"
                        ToolTip="删除选中指令；勾选多项可批量删除"
                        Command="{Binding DeleteSelectedQuickCommandsCommand}">
                    <ui:SymbolIcon Symbol="Delete20" />
                </Button>
                <Button Style="{StaticResource IconButtonStyle}"
                        ToolTip="新增命令"
                        Click="OnAddQuickCommandClick">
                    <ui:SymbolIcon Symbol="Add20" />
                </Button>
                <Button Height="24"
                        MinHeight="24"
                        MinWidth="52"
                        Margin="2,0,0,0"
                        Padding="7,2"
                        FontSize="10"
                        Content="AI导入"
                        ToolTip="选择嵌入式工程并生成导入提示词"
                        Click="OnAiImportClick" />
                <ComboBox Width="108"
                          Height="24"
                          Margin="5,0,0,0"
                          Padding="5,3"
                          FontSize="10"
                          ItemsSource="{Binding QuickCommandDataFormats}"
                          SelectedItem="{Binding SelectedQuickCommandDataFormat}"
                          ToolTip="快捷指令发送数据格式" />
                <ComboBox Width="96"
                          Height="24"
                          Margin="5,0,0,0"
                          Padding="5,3"
                          FontSize="10"
                          DisplayMemberPath="Name"
                          ItemsSource="{Binding QuickCommandCategories}"
                          SelectedItem="{Binding SelectedQuickCommandCategory}"
                          ToolTip="当前快捷指令库；切换工作页时会自动切换" />
            </WrapPanel>

            <Grid Grid.Row="1" Margin="0,8,0,7">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="120" />
                </Grid.ColumnDefinitions>
                <Grid Margin="0,0,6,0">
                    <TextBox x:Name="QuickCommandSearchTextBox"
                             Height="28"
                             Padding="25,2,28,2"
                             FontSize="11"
                             VerticalContentAlignment="Center"
                             Text="{Binding QuickCommandSearchText, UpdateSourceTrigger=PropertyChanged}"
                             ToolTip="按名称或内容查找快捷命令" />
                    <ui:SymbolIcon Margin="7,0,0,0"
                                   HorizontalAlignment="Left"
                                   VerticalAlignment="Center"
                                   Symbol="Search20"
                                   IsHitTestVisible="False" />
                    <Button Width="24"
                            Height="24"
                            MinWidth="0"
                            MinHeight="0"
                            Margin="0,2,2,2"
                            Padding="0"
                            HorizontalAlignment="Right"
                            Background="Transparent"
                            BorderThickness="0"
                            Foreground="{DynamicResource MutedTextBrush}"
                            ToolTip="清除快捷指令搜索"
                            Click="OnClearQuickCommandSearchClick">
                        <ui:SymbolIcon Symbol="Dismiss20" Width="13" Height="13" />
                    </Button>
                </Grid>
                <ComboBox Grid.Column="1"
                          Height="28"
                          Padding="5,3"
                          FontSize="10"
                          ItemsSource="{Binding QuickCommandSortOptions}"
                          SelectedItem="{Binding SelectedQuickCommandSort}"
                          ToolTip="快捷命令排序方式" />
            </Grid>

            <ListBox x:Name="QuickCommandsList"
                     Grid.Row="2"
                     ItemsSource="{Binding QuickCommandsView}"
                     SelectedItem="{Binding SelectedQuickCommand, Mode=TwoWay}"
                     SelectionChanged="OnQuickCommandSelectionChanged"
                     AllowDrop="True"
                     PreviewMouseLeftButtonDown="OnQuickCommandPreviewMouseLeftButtonDown"
                     PreviewMouseMove="OnQuickCommandPreviewMouseMove"
                     GiveFeedback="OnQuickCommandGiveFeedback"
                     PreviewDragOver="OnQuickCommandDragOver"
                     PreviewDragLeave="OnQuickCommandDragLeave"
                     PreviewDrop="OnQuickCommandDrop"
                     PreviewMouseWheel="OnQuickCommandsListPreviewMouseWheel"
                     Margin="0,0,0,3"
                     Background="{DynamicResource QuickCommandListCanvasBrush}"
                     BorderBrush="{DynamicResource DividerBrush}"
                     BorderThickness="1"
                     ScrollViewer.CanContentScroll="True"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                     VirtualizingPanel.CacheLength="0.5,0.5"
                     VirtualizingPanel.CacheLengthUnit="Page"
                     VirtualizingPanel.IsVirtualizing="True"
                     VirtualizingPanel.IsVirtualizingWhenGrouping="True"
                     VirtualizingPanel.ScrollUnit="Pixel"
                     VirtualizingPanel.VirtualizationMode="Recycling">
                <ListBox.Style>
                    <Style TargetType="ListBox">
                        <Setter Property="Padding" Value="3" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                                         Value="Compact">
                                <Setter Property="Padding" Value="2" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ListBox.Style>
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="MinHeight" Value="36" />
                        <Setter Property="Margin" Value="0,1,18,1" />
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="VerticalContentAlignment" Value="Stretch" />
                        <Setter Property="Background" Value="Transparent" />
                        <Setter Property="BorderBrush" Value="Transparent" />
                        <Setter Property="BorderThickness" Value="1" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <Grid>
                                        <Border x:Name="ItemBorder"
                                                Background="{TemplateBinding Background}"
                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="{TemplateBinding BorderThickness}"
                                                CornerRadius="4"
                                                SnapsToDevicePixels="True">
                                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                                              ContentTemplate="{TemplateBinding ContentTemplate}" />
                                        </Border>
                                        <Border Height="3"
                                                Panel.ZIndex="1000"
                                                VerticalAlignment="Top"
                                                Background="{DynamicResource ButtonForegroundBrush}"
                                                Visibility="{Binding IsDropTarget, Converter={StaticResource BooleanToVisibilityConverter}}"
                                                IsHitTestVisible="False" />
                                        <Border Height="3"
                                                Panel.ZIndex="1000"
                                                VerticalAlignment="Bottom"
                                                Background="{DynamicResource ButtonForegroundBrush}"
                                                Visibility="{Binding IsDropTargetAfter, Converter={StaticResource BooleanToVisibilityConverter}}"
                                                IsHitTestVisible="False" />
                                    </Grid>
                                    <ControlTemplate.Triggers>
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource Self}}" Value="True" />
                                                <Condition Binding="{Binding Tag, RelativeSource={RelativeSource AncestorType=ListBox}}" Value="{x:Null}" />
                                            </MultiDataTrigger.Conditions>
                                            <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource ButtonSurfaceBrush}" />
                                            <Setter TargetName="ItemBorder" Property="BorderBrush" Value="{DynamicResource DividerBrush}" />
                                        </MultiDataTrigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource ButtonSurfaceBrush}" />
                                            <Setter TargetName="ItemBorder" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                        </Trigger>
                                        <DataTrigger Binding="{Binding IsPinned}" Value="True">
                                            <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource NavigationSelectedBrush}" />
                                            <Setter TargetName="ItemBorder" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                        </DataTrigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                                         Value="Compact">
                                <Setter Property="Margin" Value="0,1,14,1" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid MinHeight="34">
                            <Border Padding="2">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <CheckBox Width="24"
                                              Height="24"
                                              Padding="0"
                                              VerticalAlignment="Center"
                                              IsChecked="{Binding IsSelectedForBulkDelete, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                              Checked="OnQuickCommandBulkDeleteSelectionChanged"
                                              Unchecked="OnQuickCommandBulkDeleteSelectionChanged"
                                              ToolTip="勾选后可批量删除" />
                                    <StackPanel Grid.Column="1" Margin="3,0,6,0">
                                        <TextBlock FontSize="12"
                                                   Text="{Binding Name}"
                                                   TextTrimming="CharacterEllipsis"
                                                   ToolTip="{Binding Name}" />
                                        <TextBlock Margin="0,2,0,0"
                                                   FontFamily="Cascadia Mono, Consolas"
                                                   FontSize="10"
                                                   Foreground="{DynamicResource MutedTextBrush}"
                                                   Text="{Binding Payload}"
                                                   TextTrimming="CharacterEllipsis"
                                                   ToolTip="{Binding Payload}" />
                                    </StackPanel>
                                    <Button Grid.Column="2"
                                            Style="{StaticResource CompactIconButtonStyle}"
                                            ToolTip="发送"
                                            Command="{Binding DataContext.SendQuickCommandCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding}">
                                        <ui:SymbolIcon Symbol="Send20" Width="14" Height="14" />
                                    </Button>
                                    <Button x:Name="QuickCommandDragHandle"
                                            Grid.Column="3"
                                            Style="{StaticResource CompactIconButtonStyle}"
                                            Cursor="SizeAll"
                                            Focusable="False"
                                            ToolTip="按住拖动调整指令顺序">
                                        <ui:SymbolIcon Symbol="ArrowMove20" Width="14" Height="14" />
                                    </Button>
                                </Grid>
                            </Border>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Grid>

        <Border Grid.Column="1"
                Width="2"
                HorizontalAlignment="Center"
                Background="{DynamicResource DividerBrush}"
                IsHitTestVisible="False"
                Panel.ZIndex="1" />
        <GridSplitter x:Name="QuickCommandColumnSplitter"
                      Grid.Column="1"
                      Width="8"
                      HorizontalAlignment="Stretch"
                      ResizeDirection="Columns"
                      ResizeBehavior="PreviousAndNext"
                      Background="Transparent"
                      Cursor="SizeWE"
                      ShowsPreview="True"
                      DragDelta="OnQuickCommandColumnSplitterDragDelta"
                      DragCompleted="OnQuickCommandColumnSplitterDragCompleted"
                      ToolTip="左右拖动调整指令栏与参数区宽度" />

        <Grid Grid.Column="2" Margin="10" DataContext="{Binding SelectedQuickCommand}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <DockPanel Margin="0,0,0,9">
                <TextBlock DockPanel.Dock="Right"
                           VerticalAlignment="Center"
                           FontSize="11"
                           Foreground="{DynamicResource MutedTextBrush}"
                           Text="{Binding Name, StringFormat=当前：{0}}"
                           TextTrimming="CharacterEllipsis" />
                <TextBlock VerticalAlignment="Center"
                           Style="{StaticResource SectionLabelStyle}"
                           FontSize="14"
                           Text="指令编辑" />
            </DockPanel>

            <Grid Grid.Row="1" Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="58" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock VerticalAlignment="Center" Text="名称" />
                <TextBox x:Name="QuickCommandEditorNameTextBox"
                         Grid.Column="1"
                         Style="{StaticResource CompactTextBoxStyle}"
                         Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                         ToolTip="快捷命令名称" />
                <TextBlock Grid.Column="2" Margin="12,0,8,0" VerticalAlignment="Center" Text="直接发送" />
                <TextBox Grid.Column="3"
                         Style="{StaticResource CompactTextBoxStyle}"
                         FontFamily="Cascadia Mono, Consolas"
                         Text="{Binding Payload, UpdateSourceTrigger=PropertyChanged}"
                         LostKeyboardFocus="OnQuickCommandPayloadLostKeyboardFocus"
                         PreviewKeyDown="OnQuickCommandPayloadPreviewKeyDown"
                         ToolTip="快捷指令栏发送和循环发送使用此内容；输入带逗号参数后按回车或离开输入框会自动生成模板" />
            </Grid>

            <Grid Grid.Row="2" Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="58" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock VerticalAlignment="Center" Text="指令模板" />
                <TextBox Grid.Column="1"
                         Style="{StaticResource CompactTextBoxStyle}"
                         FontFamily="Cascadia Mono, Consolas"
                         Text="{Binding Template, UpdateSourceTrigger=PropertyChanged}"
                         ToolTip="变量格式为 ${name}" />
            </Grid>

            <Grid Grid.Row="3" Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="48" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="64" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Button Command="{Binding DataContext.ToggleQuickCommandPinCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                        CommandParameter="{Binding}">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource CompactIconButtonStyle}">
                            <Setter Property="ToolTip" Value="置顶指令" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsPinned}" Value="True">
                                    <Setter Property="ToolTip" Value="取消置顶" />
                                    <Setter Property="Background" Value="{DynamicResource AccentSubtleBrush}" />
                                    <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                    <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                    <ui:SymbolIcon>
                        <ui:SymbolIcon.Style>
                            <Style TargetType="ui:SymbolIcon">
                                <Setter Property="Symbol" Value="Pin20" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsPinned}" Value="True">
                                        <Setter Property="Symbol" Value="PinOff20" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ui:SymbolIcon.Style>
                    </ui:SymbolIcon>
                </Button>
                <Grid Grid.Column="1" ToolTip="勾选后按 HEX 字节解析">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="25" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <CheckBox Width="22"
                              Height="22"
                              Padding="0"
                              VerticalAlignment="Center"
                              IsChecked="{Binding IsHex}" />
                    <TextBlock Grid.Column="1"
                               VerticalAlignment="Center"
                               FontSize="10"
                               Text="HEX" />
                </Grid>
                <ComboBox Grid.Column="2"
                          Height="26"
                          Margin="4,0,2,0"
                          Padding="4,2"
                          FontSize="10"
                          ItemsSource="{Binding DataContext.LineEndings, RelativeSource={RelativeSource AncestorType=Window}}"
                          SelectedItem="{Binding LineEnding}"
                          ToolTip="行尾追加方式" />
                <ComboBox Grid.Column="3"
                          Height="26"
                          Margin="2,0"
                          Padding="4,2"
                          FontSize="10"
                          ItemsSource="{Binding DataContext.ChecksumKinds, RelativeSource={RelativeSource AncestorType=Window}}"
                          SelectedItem="{Binding Checksum}"
                          ToolTip="自动追加校验" />
                <TextBox Grid.Column="4"
                         Height="26"
                         Margin="3,0"
                         Padding="0"
                         HorizontalContentAlignment="Center"
                         VerticalContentAlignment="Center"
                         TextAlignment="Center"
                         MaxLength="5"
                         Text="{Binding RepeatIntervalText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         PreviewMouseLeftButtonDown="OnRepeatIntervalPreviewMouseLeftButtonDown"
                         LostKeyboardFocus="OnRepeatIntervalLostKeyboardFocus"
                         ToolTip="指令循环发送间隔，范围 10~60000 ms" />
                <TextBlock Grid.Column="5"
                           Margin="2,0,6,0"
                           VerticalAlignment="Center"
                           FontSize="10"
                           Foreground="{DynamicResource MutedTextBrush}"
                           Text="ms" />
                <Button Grid.Column="6"
                        Style="{StaticResource CompactIconButtonStyle}"
                        ToolTip="开始或停止指令循环发送"
                        Command="{Binding DataContext.ToggleQuickRepeatCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                        CommandParameter="{Binding}">
                    <ui:SymbolIcon Symbol="ArrowRepeatAll20" Width="14" Height="14" />
                </Button>
                <Button Grid.Column="7"
                        Style="{StaticResource CompactIconButtonStyle}"
                        ToolTip="删除指令"
                        Command="{Binding DataContext.DeleteQuickCommandCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                        CommandParameter="{Binding}">
                    <ui:SymbolIcon Symbol="Delete20" Width="14" Height="14" />
                </Button>
            </Grid>

            <Border Grid.Row="4"
                    Padding="8"
                    Background="{DynamicResource QuickCommandEditorSectionBrush}"
                    BorderBrush="{DynamicResource DividerBrush}"
                    BorderThickness="1"
                    CornerRadius="5">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="70" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock VerticalAlignment="Center" FontSize="11" Text="变量方案" />
                        <ListBox x:Name="VariableSetsList"
                                 Grid.Column="1"
                                 Height="34"
                                 ItemsSource="{Binding VariableSets}"
                                 SelectedItem="{Binding SelectedVariableSet, Mode=TwoWay}"
                                 BorderThickness="0"
                                 Background="Transparent"
                                 PreviewMouseLeftButtonDown="OnVariableSetPreviewMouseLeftButtonDown"
                                 PreviewMouseWheel="OnVariableSetsPreviewMouseWheel"
                                 ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                 ScrollViewer.VerticalScrollBarVisibility="Disabled">
                            <ListBox.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ListBox.ItemsPanel>
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="Margin" Value="0,0,4,0" />
                                    <Setter Property="Padding" Value="7,3" />
                                    <Setter Property="Background" Value="{DynamicResource ButtonSurfaceBrush}" />
                                    <Setter Property="BorderBrush" Value="{DynamicResource DividerBrush}" />
                                    <Setter Property="BorderThickness" Value="1" />
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListBoxItem">
                                                <Border x:Name="SchemeBorder"
                                                        Padding="{TemplateBinding Padding}"
                                                        Background="{TemplateBinding Background}"
                                                        BorderBrush="{TemplateBinding BorderBrush}"
                                                        BorderThickness="{TemplateBinding BorderThickness}"
                                                        CornerRadius="4">
                                                    <ContentPresenter />
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsSelected" Value="True">
                                                        <Setter TargetName="SchemeBorder" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                                    </Trigger>
                                                    <DataTrigger Binding="{Binding IsPinned}" Value="True">
                                                        <Setter TargetName="SchemeBorder" Property="Background" Value="{DynamicResource NavigationSelectedBrush}" />
                                                        <Setter TargetName="SchemeBorder" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                                    </DataTrigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid MinWidth="56" Height="24">
                                        <TextBlock HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   FontSize="11"
                                                   Text="{Binding Name}"
                                                   TextTrimming="CharacterEllipsis"
                                                   ToolTip="{Binding Name}">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsRenaming}" Value="True">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <TextBox x:Name="QuickVariableSetNameTextBox"
                                                 MinWidth="56"
                                                 Height="24"
                                                 Padding="4,1"
                                                 HorizontalContentAlignment="Center"
                                                 FontSize="11"
                                                 Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                                                 PreviewKeyDown="OnVariableSetNamePreviewKeyDown"
                                                 LostKeyboardFocus="OnVariableSetNameLostKeyboardFocus">
                                            <TextBox.Style>
                                                <Style TargetType="TextBox" BasedOn="{StaticResource ConnectionTextBoxStyle}">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Setter Property="SelectionBrush" Value="{DynamicResource AccentSoftBrush}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsRenaming}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBox.Style>
                                        </TextBox>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <Button Grid.Column="2"
                                Style="{StaticResource CompactIconButtonStyle}"
                                ToolTip="复制当前方案"
                                Command="{Binding DataContext.DuplicateQuickCommandVariableSetCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                CommandParameter="{Binding SelectedVariableSet}">
                            <ui:SymbolIcon Symbol="Copy20" Width="14" Height="14" />
                        </Button>
                        <Button Grid.Column="3"
                                Style="{StaticResource CompactIconButtonStyle}"
                                ToolTip="删除当前方案"
                                Command="{Binding DataContext.DeleteQuickCommandVariableSetCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                CommandParameter="{Binding SelectedVariableSet}">
                            <ui:SymbolIcon Symbol="Delete20" Width="14" Height="14" />
                        </Button>
                        <Button Grid.Column="4"
                                Style="{StaticResource CompactIconButtonStyle}"
                                ToolTip="新建方案"
                                Command="{Binding DataContext.AddQuickCommandVariableSetCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                CommandParameter="{Binding}">
                            <ui:SymbolIcon Symbol="Add20" Width="14" Height="14" />
                        </Button>
                    </Grid>

                    <Grid Grid.Row="1" Margin="0,10,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1*" />
                                <ColumnDefinition Width="1.5*" />
                                <ColumnDefinition Width="30" />
                            </Grid.ColumnDefinitions>
                            <Border Background="{DynamicResource QuickCommandEditorHeaderBrush}"
                                    BorderBrush="{DynamicResource QuickCommandVariableGridLineBrush}"
                                    BorderThickness="1,1,1,1">
                                <TextBlock Margin="5,0"
                                           VerticalAlignment="Center"
                                           FontSize="11"
                                           Text="变量" />
                            </Border>
                            <Border Grid.Column="1"
                                    Background="{DynamicResource QuickCommandEditorHeaderBrush}"
                                    BorderBrush="{DynamicResource QuickCommandVariableGridLineBrush}"
                                    BorderThickness="0,1,1,1">
                                <TextBlock Margin="5,0"
                                           VerticalAlignment="Center"
                                           FontSize="11"
                                           Text="值" />
                            </Border>
                            <Border Grid.Column="2"
                                    Background="{DynamicResource QuickCommandEditorHeaderBrush}"
                                    BorderBrush="{DynamicResource QuickCommandVariableGridLineBrush}"
                                    BorderThickness="0,1,1,1" />
                        </Grid>
                        <ListBox Grid.Row="1"
                                 ItemsSource="{Binding SelectedVariableSet.Variables}"
                                 AlternationCount="2"
                                 Background="{DynamicResource QuickCommandVariableRowBrush}"
                                 BorderThickness="0"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="Margin" Value="0" />
                                    <Setter Property="Padding" Value="0" />
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                    <Setter Property="Background" Value="{DynamicResource QuickCommandVariableRowBrush}" />
                                    <Setter Property="BorderThickness" Value="0" />
                                    <Style.Triggers>
                                        <Trigger Property="ItemsControl.AlternationIndex" Value="1">
                                            <Setter Property="Background" Value="{DynamicResource QuickCommandVariableAlternateRowBrush}" />
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem}, Path=Background}"
                                            BorderBrush="{DynamicResource QuickCommandVariableGridLineBrush}"
                                            BorderThickness="0,0,1,1">
                                        <Grid Height="30">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="1*" />
                                            <ColumnDefinition Width="1.5*" />
                                            <ColumnDefinition Width="30" />
                                        </Grid.ColumnDefinitions>
                                        <Border BorderBrush="{DynamicResource QuickCommandVariableGridLineBrush}"
                                                BorderThickness="0,0,1,0">
                                            <TextBox Margin="3,2"
                                                     Style="{StaticResource ConnectionTextBoxStyle}"
                                                     Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" />
                                        </Border>
                                        <Border Grid.Column="1"
                                                BorderBrush="{DynamicResource QuickCommandVariableGridLineBrush}"
                                                BorderThickness="0,0,1,0">
                                            <TextBox Margin="3,2"
                                                     Style="{StaticResource ConnectionTextBoxStyle}"
                                                     FontFamily="Cascadia Mono, Consolas"
                                                     Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}" />
                                        </Border>
                                        <Button Grid.Column="2"
                                                Style="{StaticResource CompactIconButtonStyle}"
                                                ToolTip="删除变量"
                                                Command="{Binding DataContext.DeleteQuickCommandVariableCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding}">
                                            <ui:SymbolIcon Symbol="Delete20" Width="13" Height="13" />
                                        </Button>
                                    </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <Button Grid.Row="2"
                                Margin="0,7,0,0"
                                HorizontalAlignment="Left"
                                Padding="7,3"
                                Command="{Binding DataContext.AddQuickCommandVariableCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                CommandParameter="{Binding SelectedVariableSet}">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="Add20" Width="14" Height="14" />
                                <TextBlock Margin="5,0,0,0" Text="添加变量" />
                            </StackPanel>
                        </Button>
                    </Grid>
                </Grid>
            </Border>

            <Grid Grid.Row="5" Margin="0,9,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="70" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="58" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock VerticalAlignment="Center" FontSize="11" Text="发送预览" />
                <TextBox Grid.Column="1"
                         Height="28"
                         Style="{StaticResource ConnectionTextBoxStyle}"
                         IsReadOnly="True"
                         FontFamily="Cascadia Mono, Consolas"
                         Text="{Binding ResolvedPayload, Mode=OneWay}" />
                <Button Grid.Column="2"
                        Width="34"
                        Height="28"
                        Margin="6,0,0,0"
                        Style="{StaticResource PrimaryButtonStyle}"
                        MinWidth="0"
                        Padding="0"
                        ToolTip="使用此方案发送"
                        Command="{Binding DataContext.SendQuickParameterCommandCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                        CommandParameter="{Binding}">
                    <ui:SymbolIcon Symbol="Send20" Width="14" Height="14" />
                </Button>
                <Button Grid.Column="3"
                        Style="{StaticResource CompactIconButtonStyle}"
                        ToolTip="开始或停止方案循环发送"
                        Command="{Binding DataContext.ToggleQuickParameterRepeatCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                        CommandParameter="{Binding}">
                    <ui:SymbolIcon Symbol="ArrowRepeatAll20" Width="14" Height="14" />
                </Button>
                <TextBox Grid.Column="4"
                         Height="26"
                         Margin="4,0,0,0"
                         Padding="0"
                         HorizontalContentAlignment="Center"
                         VerticalContentAlignment="Center"
                         TextAlignment="Center"
                         MaxLength="5"
                         Text="{Binding ParameterRepeatIntervalText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         PreviewMouseLeftButtonDown="OnParameterRepeatIntervalPreviewMouseLeftButtonDown"
                         LostKeyboardFocus="OnParameterRepeatIntervalLostKeyboardFocus"
                         ToolTip="循环发送间隔，范围 10~60000 ms" />
                <TextBlock Grid.Column="5"
                           Margin="5,0,0,0"
                           VerticalAlignment="Center"
                           FontSize="10"
                           Foreground="{DynamicResource MutedTextBrush}"
                           Text="ms" />
            </Grid>
        </Grid>
        </Grid>
    </Grid>
</ui:FluentWindow>
