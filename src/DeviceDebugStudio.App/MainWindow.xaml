<ui:FluentWindow x:Class="DeviceDebugStudio.App.MainWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                  xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                  xmlns:converters="clr-namespace:DeviceDebugStudio.App.Converters"
                 xmlns:core="clr-namespace:DeviceDebugStudio.Core.Transports;assembly=DeviceDebugStudio.Core"
                 xmlns:infra="clr-namespace:DeviceDebugStudio.Infrastructure.Transports;assembly=DeviceDebugStudio.Infrastructure"
                 xmlns:scott="clr-namespace:ScottPlot.WPF;assembly=ScottPlot.WPF"
                 mc:Ignorable="d"
                 Title="嵌入式调试台"
                 Icon="Assets/DeviceDebugStudio.ico"
                 Width="1280"
                 Height="720"
                 MinWidth="1000"
                 MinHeight="620"
                 FontSize="12"
                 Background="{DynamicResource WorkspaceBackgroundBrush}"
                 TextOptions.TextFormattingMode="Display"
                 TextOptions.TextRenderingMode="ClearType"
                 UseLayoutRounding="True"
                 SnapsToDevicePixels="True"
                 WindowStartupLocation="CenterScreen"
                  ExtendsContentIntoTitleBar="True"
                  Tag="Normal"
                  SizeChanged="OnWindowSizeChanged"
                  Closing="OnWindowClosing">
    <ui:FluentWindow.Resources>
        <converters:TerminalDisplayTextConverter x:Key="TerminalDisplayTextConverter" />
        <Style x:Key="SeparatedHorizontalScrollViewerStyle" TargetType="{x:Type ScrollViewer}">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="IsTabStop" Value="False" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ScrollViewer}">
                        <Grid Background="{TemplateBinding Background}" ClipToBounds="True">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <ScrollContentPresenter x:Name="PART_ScrollContentPresenter"
                                                    CanContentScroll="{TemplateBinding CanContentScroll}"
                                                    Content="{TemplateBinding Content}"
                                                    ContentTemplate="{TemplateBinding ContentTemplate}" />
                            <ScrollBar x:Name="PART_HorizontalScrollBar"
                                       Grid.Row="1"
                                       Height="8"
                                       Margin="0,2"
                                       VerticalAlignment="Center"
                                       Style="{x:Null}"
                                       Background="Transparent"
                                       Maximum="{TemplateBinding ScrollableWidth}"
                                       Orientation="Horizontal"
                                       ViewportSize="{TemplateBinding ViewportWidth}"
                                       Visibility="{TemplateBinding ComputedHorizontalScrollBarVisibility}"
                                       Value="{Binding HorizontalOffset, Mode=OneWay, RelativeSource={RelativeSource TemplatedParent}}">
                                <ScrollBar.Template>
                                    <ControlTemplate TargetType="{x:Type ScrollBar}">
                                        <Grid Background="Transparent">
                                            <Border Height="3"
                                                    VerticalAlignment="Center"
                                                    Background="{DynamicResource DividerBrush}"
                                                    CornerRadius="1.5" />
                                            <Track x:Name="PART_Track"
                                                   IsDirectionReversed="False"
                                                   Orientation="Horizontal">
                                                <Track.DecreaseRepeatButton>
                                                    <RepeatButton Command="{x:Static ScrollBar.PageLeftCommand}"
                                                                  Focusable="False"
                                                                  Opacity="0" />
                                                </Track.DecreaseRepeatButton>
                                                <Track.Thumb>
                                                    <Thumb MinWidth="24">
                                                        <Thumb.Template>
                                                            <ControlTemplate TargetType="{x:Type Thumb}">
                                                                <Border x:Name="ThumbBorder"
                                                                        Height="6"
                                                                        VerticalAlignment="Center"
                                                                        Background="{DynamicResource MutedTextBrush}"
                                                                        CornerRadius="3"
                                                                        Opacity="0.75" />
                                                                <ControlTemplate.Triggers>
                                                                    <Trigger Property="IsMouseOver" Value="True">
                                                                        <Setter TargetName="ThumbBorder" Property="Opacity" Value="1" />
                                                                    </Trigger>
                                                                </ControlTemplate.Triggers>
                                                            </ControlTemplate>
                                                        </Thumb.Template>
                                                    </Thumb>
                                                </Track.Thumb>
                                                <Track.IncreaseRepeatButton>
                                                    <RepeatButton Command="{x:Static ScrollBar.PageRightCommand}"
                                                                  Focusable="False"
                                                                  Opacity="0" />
                                                </Track.IncreaseRepeatButton>
                                            </Track>
                                        </Grid>
                                    </ControlTemplate>
                                </ScrollBar.Template>
                            </ScrollBar>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="ConnectionFieldLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="9" />
            <Setter Property="Height" Value="13" />
            <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}" />
            <Setter Property="Margin" Value="3,0,0,2" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="FrameOptionLabelStyle" TargetType="TextBlock" BasedOn="{StaticResource ConnectionFieldLabelStyle}">
            <Setter Property="FontSize" Value="10" />
            <Setter Property="Margin" Value="2,0,0,2" />
        </Style>
        <Style x:Key="SendOptionLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10" />
            <Setter Property="FontWeight" Value="Normal" />
            <Setter Property="Foreground" Value="{DynamicResource ButtonForegroundBrush}" />
            <Setter Property="Margin" Value="0,0,0,2" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="QuickCommandActionButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource CompactIconButtonStyle}">
            <Setter Property="Width" Value="26" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="Height" Value="26" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="Margin" Value="2,0" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                             Value="Compact">
                    <Setter Property="Width" Value="24" />
                    <Setter Property="Height" Value="24" />
                    <Setter Property="Margin" Value="1,0" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="QuickCommandActionIconStyle" TargetType="ui:SymbolIcon">
            <Setter Property="Width" Value="12" />
            <Setter Property="Height" Value="12" />
            <Setter Property="FontSize" Value="12" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                             Value="Compact">
                    <Setter Property="Width" Value="10" />
                    <Setter Property="Height" Value="10" />
                    <Setter Property="FontSize" Value="10" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <DropShadowEffect x:Key="QuickCommandEditorShadowEffect"
                          Color="#26364A"
                          BlurRadius="12"
                          ShadowDepth="3"
                          Opacity="0.18" />
    </ui:FluentWindow.Resources>
    <Grid x:Name="WindowLayoutRoot" Background="{DynamicResource WorkspaceBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="44" />
            <RowDefinition Height="36" />
            <RowDefinition Height="*" />
            <RowDefinition Height="22" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0"
                     Icon="{ui:SymbolIcon DeveloperBoard24}"
                     Title="{Binding RelativeSource={RelativeSource AncestorType={x:Type ui:FluentWindow}}, Path=Title}" />

        <Border Grid.Row="1"
                Background="{DynamicResource PanelBackgroundBrush}"
                BorderBrush="{DynamicResource DividerBrush}"
                BorderThickness="0,0,0,1">
            <DockPanel Margin="10,0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Padding="6,2"
                            VerticalAlignment="Center"
                            Background="{DynamicResource SidebarBackgroundBrush}"
                            BorderBrush="{DynamicResource DividerBrush}"
                            BorderThickness="1"
                            CornerRadius="5">
                        <TextBlock VerticalAlignment="Center"
                                   FontSize="11"
                                   MaxWidth="240"
                                   Foreground="{DynamicResource MutedTextBrush}"
                                   TextTrimming="CharacterEllipsis"
                                   ToolTip="{Binding ConnectionSummary}"
                                   Text="{Binding ConnectionSummary}" />
                    </Border>
                    <Border Width="1"
                            Height="16"
                            Margin="8,0,6,0"
                            Background="{DynamicResource DividerBrush}" />
                    <Button Style="{StaticResource IconButtonStyle}" ToolTip="显示或隐藏设备面板" Click="OnToggleDevicePanelClick">
                        <ui:SymbolIcon Symbol="PanelLeft20" Width="15" Height="15" FontSize="15" />
                    </Button>
                    <Button Style="{StaticResource IconButtonStyle}" ToolTip="切换主题" Click="OnToggleThemeClick">
                        <ui:SymbolIcon Symbol="DarkTheme20" Width="15" Height="15" FontSize="15" />
                    </Button>
                    <Button Style="{StaticResource IconButtonStyle}" ToolTip="显示或隐藏命令面板" Click="OnToggleCommandPanelClick">
                        <ui:SymbolIcon Symbol="PanelRight20" Width="15" Height="15" FontSize="15" />
                    </Button>
                    <Button Style="{StaticResource IconButtonStyle}" ToolTip="打开捕获数据库" Click="OnOpenCaptureClick">
                        <ui:SymbolIcon Symbol="FolderOpen20" Width="15" Height="15" FontSize="15" />
                    </Button>
                    <Button Style="{StaticResource IconButtonStyle}"
                            ToolTip="检查 GitHub 更新"
                            Click="OnCheckForUpdatesClick">
                        <ui:SymbolIcon Symbol="ArrowSync20" Width="15" Height="15" FontSize="15" />
                    </Button>
                    <Button Style="{StaticResource IconButtonStyle}" ToolTip="设置" Click="OnOpenSettingsClick">
                        <ui:SymbolIcon Symbol="Settings20" Width="15" Height="15" FontSize="15" />
                    </Button>
                </StackPanel>
            </DockPanel>
        </Border>

        <Grid x:Name="PanelLayoutGrid" Grid.Row="2" ClipToBounds="True">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="DevicePanelColumn" Width="0" />
                    <ColumnDefinition x:Name="DeviceSplitterColumn" Width="0" />
                    <ColumnDefinition x:Name="WorkspaceColumn" MinWidth="480" Width="*" />
                    <ColumnDefinition x:Name="CommandSplitterColumn" Width="5" />
                    <ColumnDefinition x:Name="CommandPanelColumn" MinWidth="480" MaxWidth="620" Width="500" />
                </Grid.ColumnDefinitions>

            <Border x:Name="DevicePanelBorder"
                    Grid.Column="0"
                    Background="{DynamicResource SidebarBackgroundBrush}"
                    BorderBrush="{DynamicResource DividerBrush}"
                    BorderThickness="0,0,1,0">
                <Grid x:Name="DevicePanelContentGrid">
                    <Grid.Style>
                        <Style TargetType="Grid">
                            <Setter Property="Margin" Value="10" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                                             Value="Compact">
                                    <Setter Property="Margin" Value="6" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Grid.Style>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <DockPanel Margin="2,0,2,8">
                        <TextBlock DockPanel.Dock="Left" VerticalAlignment="Center" Style="{StaticResource SectionLabelStyle}" Text="设备工作区" />
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <Button Style="{StaticResource IconButtonStyle}" ToolTip="新增设备" Command="{Binding AddProfileCommand}">
                                <ui:SymbolIcon Symbol="Add20" />
                            </Button>
                            <Button Style="{StaticResource IconButtonStyle}" ToolTip="删除设备" Click="OnDeleteProfileClick">
                                <ui:SymbolIcon Symbol="Delete20" />
                            </Button>
                        </StackPanel>
                    </DockPanel>

                    <ListBox Grid.Row="1"
                             ItemsSource="{Binding Profiles}"
                             SelectedItem="{Binding SelectedProfile}"
                             BorderThickness="0"
                             Background="Transparent"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                                <Setter Property="Margin" Value="0,2" />
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="Background" Value="Transparent" />
                                <Setter Property="Foreground" Value="{DynamicResource ButtonForegroundBrush}" />
                                <Setter Property="BorderBrush" Value="Transparent" />
                                <Setter Property="BorderThickness" Value="1" />
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="VerticalContentAlignment" Value="Center" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border x:Name="ProfileItemBorder"
                                                    Background="{TemplateBinding Background}"
                                                    BorderBrush="{TemplateBinding BorderBrush}"
                                                    BorderThickness="{TemplateBinding BorderThickness}"
                                                    CornerRadius="6"
                                                    SnapsToDevicePixels="True">
                                                <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                                  VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="ProfileItemBorder" Property="Background" Value="{DynamicResource ButtonSurfaceBrush}" />
                                                    <Setter TargetName="ProfileItemBorder" Property="BorderBrush" Value="{DynamicResource DividerBrush}" />
                                                </Trigger>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="ProfileItemBorder" Property="Background" Value="{DynamicResource ButtonSurfaceBrush}" />
                                                    <Setter TargetName="ProfileItemBorder" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                                </Trigger>
                                                <Trigger Property="IsEnabled" Value="False">
                                                    <Setter TargetName="ProfileItemBorder" Property="Opacity" Value="0.5" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.Style>
                                        <Style TargetType="Grid">
                                            <Setter Property="Margin" Value="4,5" />
                                            <Setter Property="MinHeight" Value="38" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                                                             Value="Compact">
                                                    <Setter Property="Margin" Value="2,3" />
                                                    <Setter Property="MinHeight" Value="34" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Grid.Style>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="28" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border Background="{DynamicResource PanelBackgroundBrush}" CornerRadius="4">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Width" Value="26" />
                                                <Setter Property="Height" Value="26" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                                                                 Value="Compact">
                                                        <Setter Property="Width" Value="22" />
                                                        <Setter Property="Height" Value="22" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <ui:SymbolIcon Foreground="{DynamicResource AccentBrush}">
                                            <ui:SymbolIcon.Style>
                                                <Style TargetType="{x:Type ui:SymbolIcon}">
                                                    <Setter Property="Symbol" Value="UsbPlug20" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Transport.Kind}" Value="TcpClient">
                                                            <Setter Property="Symbol" Value="Server20" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Transport.Kind}" Value="TcpServer">
                                                            <Setter Property="Symbol" Value="Server20" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Transport.Kind}" Value="Udp">
                                                            <Setter Property="Symbol" Value="VirtualNetwork20" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Transport.Kind}" Value="BleGatt">
                                                            <Setter Property="Symbol" Value="Bluetooth20" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </ui:SymbolIcon.Style>
                                        </ui:SymbolIcon>
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Name}"
                                                   TextTrimming="CharacterEllipsis"
                                                   ToolTip="{Binding Name}" />
                                        <TextBlock FontSize="11"
                                                   Foreground="{DynamicResource MutedTextBrush}"
                                                   Text="{Binding Transport.Kind}" />
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <StackPanel Grid.Row="2" Margin="0,8,0,0">
                        <TextBlock Style="{StaticResource SectionLabelStyle}" Text="当前设备名称" />
                        <TextBox Margin="0,0,0,7" Style="{StaticResource CompactTextBoxStyle}" Text="{Binding ProfileName, UpdateSourceTrigger=PropertyChanged}" />
                        <Button x:Name="ProfileActionsButton"
                                Margin="0,0,0,6"
                                Padding="8,6"
                                HorizontalContentAlignment="Left"
                                Style="{StaticResource RoundedButtonStyle}"
                                Click="OnOpenProfileActionsClick">
                            <Button.ContextMenu>
                                <ContextMenu x:Name="ProfileActionsMenu">
                                    <MenuItem Header="导入 SSCOM / NetAssist" Click="OnImportLegacyClick" />
                                    <Separator />
                                    <MenuItem Header="导入设备配置 JSON" Click="OnImportDeviceProfileClick" />
                                    <MenuItem Header="导出当前设备 JSON" Click="OnExportDeviceProfileClick" />
                                    <Separator />
                                    <MenuItem Header="打开捕获数据库" Click="OnOpenCaptureClick" />
                                    <MenuItem Header="选择配置保存目录" Click="OnConfigureProfileDirectoryClick" />
                                </ContextMenu>
                            </Button.ContextMenu>
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="MoreHorizontal20" />
                                <TextBlock Margin="8,0,0,0" Text="配置操作" />
                            </StackPanel>
                        </Button>
                        <Button Padding="8,6" HorizontalContentAlignment="Left" Command="{Binding SaveSelectedProfileCommand}">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="Save20" />
                                <TextBlock Margin="8,0,0,0" Text="保存设备配置" />
                            </StackPanel>
                        </Button>
                        <TextBlock Margin="2,6,2,0"
                                   FontSize="10"
                                   Foreground="{DynamicResource MutedTextBrush}"
                                   Text="{Binding ProfileDirectory}"
                                   TextTrimming="CharacterEllipsis"
                                   ToolTip="{Binding ProfileDirectory}" />
                    </StackPanel>
                </Grid>
            </Border>

            <GridSplitter Grid.Column="1"
                          Width="5"
                          HorizontalAlignment="Stretch"
                          Background="Transparent"
                          ShowsPreview="True"
                          DragCompleted="OnDeviceSplitterDragCompleted" />

            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0"
                        Padding="8,3"
                        Background="{DynamicResource PanelBackgroundBrush}"
                        BorderBrush="{DynamicResource DividerBrush}"
                        BorderThickness="0,0,0,1">
                    <DockPanel LastChildFill="True">
                        <Button DockPanel.Dock="Right"
                                Margin="4,0,0,0"
                                Style="{StaticResource IconButtonStyle}"
                                ToolTip="添加窗口"
                                Click="OnAddWindowClick">
                            <ui:SymbolIcon Symbol="Add20" />
                        </Button>
                    <ListBox ItemsSource="{Binding WorkspaceModes}"
                             SelectedItem="{Binding SelectedWorkspaceMode}"
                             BorderThickness="0"
                             Background="Transparent"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                                <Setter Property="MinWidth" Value="0" />
                                <Setter Property="Height" Value="26" />
                                <Setter Property="Margin" Value="0,0,4,0" />
                                <Setter Property="Padding" Value="8,2" />
                                <Setter Property="Background" Value="{DynamicResource ButtonSurfaceBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource ButtonForegroundBrush}" />
                                <Setter Property="BorderBrush" Value="{DynamicResource DividerBrush}" />
                                <Setter Property="BorderThickness" Value="1" />
                                <Setter Property="HorizontalContentAlignment" Value="Center" />
                                <Setter Property="VerticalContentAlignment" Value="Center" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border x:Name="ModeBorder"
                                                    Background="{TemplateBinding Background}"
                                                    BorderBrush="{TemplateBinding BorderBrush}"
                                                    BorderThickness="{TemplateBinding BorderThickness}"
                                                    CornerRadius="5"
                                                    SnapsToDevicePixels="True">
                                                <ContentPresenter Margin="{TemplateBinding Padding}"
                                                                  HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                                  VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="ModeBorder" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                                </Trigger>
                                                 <Trigger Property="IsSelected" Value="True">
                                                     <Setter TargetName="ModeBorder" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                                 </Trigger>
                                                <Trigger Property="IsEnabled" Value="False">
                                                    <Setter TargetName="ModeBorder" Property="Opacity" Value="0.5" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <ui:SymbolIcon Width="13" Height="13" Margin="0,0,4,0" FontSize="13">
                                        <ui:SymbolIcon.Style>
                                            <Style TargetType="ui:SymbolIcon">
                                                <Setter Property="Symbol" Value="SerialPort20" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Mode}" Value="Network">
                                                        <Setter Property="Symbol" Value="VirtualNetwork20" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Mode}" Value="Bluetooth">
                                                        <Setter Property="Symbol" Value="Bluetooth20" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Mode}" Value="Modbus">
                                                        <Setter Property="Symbol" Value="TableSwitch20" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </ui:SymbolIcon.Style>
                                    </ui:SymbolIcon>
                                    <TextBlock VerticalAlignment="Center" FontSize="10" FontWeight="Normal" Text="{Binding Name}" />
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    </DockPanel>
                </Border>

                <Border Grid.Row="1"
                        MinHeight="52"
                        Padding="8,2"
                        Background="{DynamicResource PanelBackgroundBrush}"
                        BorderBrush="{DynamicResource DividerBrush}"
                        BorderThickness="0,0,0,1">
                    <Grid x:Name="ConnectionHeaderGrid" VerticalAlignment="Center">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel x:Name="ConnectionActionsPanel"
                                    Grid.Column="1"
                                    Margin="10,0,0,0"
                                    Orientation="Horizontal"
                                    VerticalAlignment="Center">
                            <ui:ToggleSwitch x:Name="AutoReconnectToggle"
                                             Height="24"
                                             Margin="0,0,8,0"
                                             FontSize="10"
                                             FontWeight="Normal"
                                             Foreground="{DynamicResource ButtonForegroundBrush}"
                                             Content="{Binding AutoReconnectText}"
                                             IsChecked="{Binding AutoReconnect, Mode=TwoWay}"
                                             ToolTip="仅在连接意外中断时自动重连；手动点击断开不会自动重连" />
                            <Button x:Name="ConnectionActionButton"
                                    Height="24"
                                    MinHeight="24"
                                    Padding="6,2"
                                    FontSize="10"
                                    Style="{StaticResource ConnectionButtonStyle}"
                                    Command="{Binding ToggleConnectionCommand}">
                                <StackPanel Orientation="Horizontal">
                                    <ui:SymbolIcon Width="13" Height="13" Margin="0,0,3,0" Symbol="PlugConnected20" />
                                    <TextBlock Text="{Binding ConnectionButtonText}" />
                                </StackPanel>
                            </Button>
                        </StackPanel>

                        <ScrollViewer x:Name="ConnectionParametersScrollViewer"
                                      Grid.Column="0"
                                      Style="{StaticResource SeparatedHorizontalScrollViewerStyle}"
                                      HorizontalAlignment="Stretch"
                                      VerticalAlignment="Center"
                                      VerticalContentAlignment="Center"
                                      HorizontalScrollBarVisibility="Auto"
                                      VerticalScrollBarVisibility="Disabled"
                                      PanningMode="HorizontalOnly">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <StackPanel Width="100" Height="39" Margin="0,0,4,0" VerticalAlignment="Top">
                                    <StackPanel.Style>
                                        <Style TargetType="StackPanel">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsSerialWorkspace}" Value="True">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsModbusWorkspace}" Value="True">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </StackPanel.Style>
                                    <TextBlock Style="{StaticResource ConnectionFieldLabelStyle}" Text="传输方式" />
                                    <ComboBox Height="24"
                                              Style="{StaticResource ConnectionComboBoxStyle}"
                                              ItemsSource="{Binding AvailableTransportOptions}"
                                              SelectedItem="{Binding SelectedTransportOption}"
                                              DisplayMemberPath="Name"
                                              ToolTip="传输方式：串口、TCP 客户端、TCP 服务器、UDP、BLE 等；切换后下方参数栏会随之变化。" />
                                </StackPanel>

                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SelectedTransportOption.Kind}" Value="Serial">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsModbusWorkspace}" Value="True">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>
                                <StackPanel Width="148" Height="39" Margin="0,0,2,0" VerticalAlignment="Top">
                                    <TextBlock Style="{StaticResource ConnectionFieldLabelStyle}" Text="串口" />
                                    <ComboBox Height="24"
                                              Style="{StaticResource ConnectionComboBoxStyle}"
                                              ItemsSource="{Binding SerialPorts}"
                                              SelectedValue="{Binding PortName}"
                                              SelectedValuePath="PortName"
                                              DisplayMemberPath="CompactDisplayName"
                                              ToolTip="{Binding SelectedItem.DisplayName, RelativeSource={RelativeSource Self}}" />
                                </StackPanel>
                                <StackPanel Width="24" Height="39" Margin="0,0,2,0" VerticalAlignment="Top">
                                    <TextBlock Style="{StaticResource ConnectionFieldLabelStyle}" Text=" " />
                                    <Button Margin="0" Style="{StaticResource CompactIconButtonStyle}" ToolTip="刷新串口" Command="{Binding RefreshPortsCommand}">
                                        <ui:SymbolIcon Symbol="ArrowSync20" FontSize="14" />
                                    </Button>
                                </StackPanel>
                                <StackPanel Width="88" Height="39" Margin="2,0,4,0" VerticalAlignment="Top">
                                    <TextBlock Style="{StaticResource ConnectionFieldLabelStyle}" Text="波特率" />
                                    <ComboBox Height="24"
                                              x:Name="BaudRateComboBox"
                                              Style="{StaticResource ConnectionComboBoxStyle}"
                                              IsEditable="True"
                                              IsTextSearchEnabled="False"
                                              ItemsSource="{Binding BaudRates}"
                                              Text="{Binding BaudRate, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>
                                <StackPanel Height="39" Margin="0,0,6,0" VerticalAlignment="Top">
                                    <TextBlock Style="{StaticResource ConnectionFieldLabelStyle}" Text=" " />
                                    <CheckBox Height="24"
                                              MinWidth="0"
                                              Margin="0"
                                              Padding="0"
                                              HorizontalContentAlignment="Left"
                                              VerticalAlignment="Top"
                                              FontSize="10"
                                              Content="DTR"
                                              IsChecked="{Binding DtrEnable}" />
                                </StackPanel>
                                <StackPanel Height="39" Margin="0" VerticalAlignment="Top">
                                    <TextBlock Style="{StaticResource ConnectionFieldLabelStyle}" Text=" " />
                                    <CheckBox Height="24"
                                              MinWidth="0"
                                              Margin="0"
                                              Padding="0"
                                              HorizontalContentAlignment="Left"
                                              VerticalAlignment="Top"
                                              FontSize="10"
                                              Content="RTS"
                                              IsChecked="{Binding RtsEnable}" />
                                </StackPanel>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SelectedTransportOption.Kind}" Value="TcpClient">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding SelectedTransportOption.Kind}" Value="Udp">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>
                                <StackPanel Width="140" Height="39" Margin="0,0,5,0" VerticalAlignment="Top">
                                    <TextBlock>
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock" BasedOn="{StaticResource ConnectionFieldLabelStyle}">
                                                <Setter Property="Text" Value="目标地址" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding SelectedTransportOption.Kind}" Value="TcpClient">
                                                        <Setter Property="Text" Value="服务器地址" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <TextBox Height="24"
                                             Style="{StaticResource ConnectionTextBoxStyle}"
                                             Text="{Binding Host, UpdateSourceTrigger=PropertyChanged}"
                                             ToolTip="TCP 服务器或 UDP 目标的 IP 地址、主机名" />
                                </StackPanel>
                                <StackPanel Width="64" Height="39" Margin="0,0,6,0" VerticalAlignment="Top">
                                    <TextBlock>
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock" BasedOn="{StaticResource ConnectionFieldLabelStyle}">
                                                <Setter Property="Text" Value="目标端口" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding SelectedTransportOption.Kind}" Value="TcpClient">
                                                        <Setter Property="Text" Value="服务器端口" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <TextBox Height="24"
                                             Style="{StaticResource ConnectionTextBoxStyle}"
                                             Text="{Binding RemotePort, UpdateSourceTrigger=PropertyChanged}"
                                             ToolTip="TCP 服务器或 UDP 目标的端口号" />
                                </StackPanel>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SelectedTransportOption.Kind}" Value="TcpServer">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding SelectedTransportOption.Kind}" Value="Udp">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>
                                <StackPanel Width="112" Height="39" Margin="0,0,5,0" VerticalAlignment="Top">
                                    <TextBlock>
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock" BasedOn="{StaticResource ConnectionFieldLabelStyle}">
                                                <Setter Property="Text" Value="本地地址" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding SelectedTransportOption.Kind}" Value="TcpServer">
                                                        <Setter Property="Text" Value="监听地址" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <TextBox Height="24"
                                             Style="{StaticResource ConnectionTextBoxStyle}"
                                             Text="{Binding LocalAddress, UpdateSourceTrigger=PropertyChanged}"
                                             ToolTip="TCP 服务端绑定的本机 IP；0.0.0.0 表示监听所有网卡" />
                                </StackPanel>
                                <StackPanel Width="64" Height="39" Margin="0,0,6,0" VerticalAlignment="Top">
                                    <TextBlock>
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock" BasedOn="{StaticResource ConnectionFieldLabelStyle}">
                                                <Setter Property="Text" Value="本地端口" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding SelectedTransportOption.Kind}" Value="TcpServer">
                                                        <Setter Property="Text" Value="监听端口" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <TextBox Height="24"
                                             Style="{StaticResource ConnectionTextBoxStyle}"
                                             Text="{Binding LocalPort, UpdateSourceTrigger=PropertyChanged}"
                                             ToolTip="本机绑定或监听的端口号" />
                                </StackPanel>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SelectedTransportOption.Kind}" Value="BleGatt">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>
                                <StackPanel Width="210" Height="39" Margin="0,0,4,0" VerticalAlignment="Top">
                                    <TextBlock Style="{StaticResource ConnectionFieldLabelStyle}" Text="蓝牙设备" />
                                    <ComboBox Height="24"
                                              Style="{StaticResource ConnectionComboBoxStyle}"
                                              ItemsSource="{Binding BleDevices}"
                                              SelectedItem="{Binding SelectedBleDevice}"
                                              DisplayMemberPath="DisplayName" />
                                </StackPanel>
                                <StackPanel Width="24" Height="39" VerticalAlignment="Top">
                                    <TextBlock Style="{StaticResource ConnectionFieldLabelStyle}" Text=" " />
                                    <Button Margin="0" Style="{StaticResource CompactIconButtonStyle}" ToolTip="扫描 BLE" Command="{Binding ScanBleCommand}">
                                        <ui:SymbolIcon Symbol="BluetoothSearching20" Width="14" Height="14" />
                                    </Button>
                                </StackPanel>
                                </StackPanel>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </Border>

                <TabControl Grid.Row="2" Margin="8,6,8,8" SelectedIndex="{Binding SelectedWorkspaceTabIndex}">
                    <TabItem Header="{Binding TerminalTabHeader}">
                        <Grid PreviewMouseWheel="OnTerminalPreviewMouseWheel">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="8" />
                            <RowDefinition Height="Auto" MinHeight="126" MaxHeight="346" />
                        </Grid.RowDefinitions>

                            <Grid x:Name="TerminalToolbarGrid" Margin="0,0,0,4" MinHeight="32">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition x:Name="TerminalSearchColumn" Width="260" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <WrapPanel x:Name="TerminalToolsPanel"
                                           Grid.Column="1"
                                           Margin="10,0,0,0"
                                           VerticalAlignment="Center">
                                    <ui:ToggleSwitch Height="24" Margin="0,0,8,3" FontSize="11" FontWeight="Normal" Foreground="{DynamicResource ButtonForegroundBrush}" Content="HEX" FocusVisualStyle="{x:Null}" IsChecked="{Binding ReceiveAsHex}" ToolTip="HEX 显示：仅切换通信记录显示，不影响发送格式" />
                                    <ui:ToggleSwitch Height="24" Margin="0,0,8,3" FontSize="11" FontWeight="Normal" Foreground="{DynamicResource ButtonForegroundBrush}" Content="暂停显示" FocusVisualStyle="{x:Null}" IsChecked="{Binding IsPaused}" ToolTip="暂停把新通信记录加入终端显示；连接和接收计数继续运行" />
                                    <ui:ToggleSwitch Height="24" Margin="0,0,6,3" FontSize="11" FontWeight="Normal" Foreground="{DynamicResource ButtonForegroundBrush}" Content="自动滚动" FocusVisualStyle="{x:Null}" IsChecked="{Binding AutoScroll}" ToolTip="显示新记录时自动滚动到底部，不影响数据接收" />
                                    <ui:ToggleSwitch Height="24" Margin="0,0,6,3" FontSize="11" FontWeight="Normal" Foreground="{DynamicResource ButtonForegroundBrush}" Content="记录" FocusVisualStyle="{x:Null}" IsChecked="{Binding CaptureCommunication}" ToolTip="开启后从下一次连接开始，将通信收发数据保存为 SQLite 捕获文件" />
                                    <Button Style="{StaticResource CompactIconButtonStyle}"
                                            ToolTip="清空显示"
                                            Command="{Binding ClearTerminalCommand}">
                                        <ui:SymbolIcon Symbol="Delete20" Width="14" Height="14" />
                                    </Button>
                                    <Button x:Name="TerminalMoreButton"
                                            Style="{StaticResource CompactIconButtonStyle}"
                                            ToolTip="更多终端操作"
                                            Click="OnOpenTerminalMoreMenuClick">
                                        <Button.ContextMenu>
                                            <ContextMenu x:Name="TerminalMoreMenu"
                                                         DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                                                <MenuItem Header="保存连续文本 TXT" Click="OnSaveTerminalPlainTextClick">
                                                    <MenuItem.Icon>
                                                        <ui:SymbolIcon Symbol="Save20" />
                                                    </MenuItem.Icon>
                                                </MenuItem>
                                                <MenuItem Header="导出表格 CSV" Click="OnExportTerminalTableCsvClick">
                                                    <MenuItem.Icon>
                                                        <ui:SymbolIcon Symbol="DocumentTable20" />
                                                    </MenuItem.Icon>
                                                </MenuItem>
                                            </ContextMenu>
                                        </Button.ContextMenu>
                                        <ui:SymbolIcon Symbol="MoreHorizontal20" Width="14" Height="14" />
                                    </Button>
                                </WrapPanel>
                                <Border x:Name="TerminalSearchBorder"
                                        Grid.Column="0"
                                        Width="260"
                                        Height="30"
                                        MinHeight="28"
                                        HorizontalAlignment="Left"
                                        Background="{DynamicResource PanelBackgroundBrush}"
                                        BorderThickness="1"
                                        CornerRadius="6">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="BorderBrush" Value="{DynamicResource DividerBrush}" />
                                            <Style.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="BorderBrush" Value="{DynamicResource MutedTextBrush}" />
                                                </Trigger>
                                                <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                                    <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="34" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <ui:SymbolIcon x:Name="TerminalSearchIcon"
                                                       Grid.Column="0"
                                                       Width="16"
                                                       Height="16"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"
                                                       Symbol="Search20"
                                                       IsHitTestVisible="False" />
                                        <TextBox x:Name="TerminalSearchTextBox"
                                                 Grid.Column="1"
                                                 Style="{StaticResource CompactTextBoxStyle}"
                                                 Height="28"
                                                 MinHeight="0"
                                                 Padding="4,1,7,1"
                                                 FontSize="13"
                                                 Background="Transparent"
                                                 BorderThickness="0"
                                                 Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                                 ToolTip="搜索时间、字节、方向、端点或内容" />
                                    </Grid>
                                </Border>
                            </Grid>

                            <TabControl x:Name="TerminalDisplayTabs"
                                        Grid.Row="1"
                                        BorderThickness="0"
                                        Background="Transparent"
                                        SelectionChanged="OnTerminalDisplaySelectionChanged">
                                <TabItem x:Name="TerminalPlainTextTab" Header="连续文本">
                                    <Grid>
                                        <Border Background="{DynamicResource TerminalBackgroundBrush}"
                                                BorderBrush="{DynamicResource DividerBrush}"
                                                BorderThickness="1"
                                                CornerRadius="5">
                                            <RichTextBox x:Name="TerminalPlainTextBox"
                                                         Style="{StaticResource TerminalPlainTextBoxStyle}"
                                                         FontSize="{Binding TerminalFontSize}">
                                                <RichTextBox.Document>
                                                    <FlowDocument PagePadding="0">
                                                        <Paragraph Margin="0" />
                                                    </FlowDocument>
                                                </RichTextBox.Document>
                                                <RichTextBox.ContextMenu>
                                                    <ContextMenu>
                                                        <MenuItem Header="复制" Command="{x:Static ApplicationCommands.Copy}" />
                                                        <MenuItem Header="全选" Click="OnSelectAllTerminalTextClick" />
                                                        <Separator />
                                                        <MenuItem Header="保存连续文本 TXT" Click="OnSaveTerminalPlainTextClick" />
                                                    </ContextMenu>
                                                </RichTextBox.ContextMenu>
                                            </RichTextBox>
                                        </Border>
                                        <Border IsHitTestVisible="False"
                                                Panel.ZIndex="1"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                Padding="0"
                                                Background="Transparent">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding TerminalRecords.Count}" Value="0">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"
                                                           FontSize="11"
                                                           FontWeight="Normal"
                                                           Foreground="{DynamicResource MutedTextBrush}"
                                                           Text="暂无通信数据" />
                                        </Border>
                                    </Grid>
                                </TabItem>
                                <TabItem x:Name="TerminalTableTab" Header="表格">
                                    <Grid>
                                        <Border Background="{DynamicResource TerminalBackgroundBrush}"
                                                BorderBrush="{DynamicResource DividerBrush}"
                                                BorderThickness="1"
                                                CornerRadius="5">
                                            <ListView x:Name="TerminalList"
                                      ItemsSource="{Binding TerminalRecords}"
                                      SelectionMode="Extended"
                                      SizeChanged="OnTerminalListSizeChanged"
                                      ScrollViewer.ScrollChanged="OnTerminalListScrollChanged"
                                      PreviewKeyDown="OnTerminalPreviewKeyDown"
                                      Background="{DynamicResource TerminalBackgroundBrush}"
                                      Foreground="{DynamicResource TerminalTextBrush}"
                                      BorderThickness="0"
                                       FontFamily="Cascadia Mono, Consolas"
                                       FontSize="{Binding TerminalFontSize}"
                                       ScrollViewer.CanContentScroll="True"
                                       ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                       VirtualizingPanel.IsVirtualizing="True"
                                      VirtualizingPanel.VirtualizationMode="Recycling">
                                <ListView.Resources>
                                    <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="#315F58" />
                                    <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="#FFFFFF" />
                                    <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}" Color="#284C48" />
                                </ListView.Resources>
                                <ListView.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Header="复制所选整行" Click="OnCopySelectedTerminalRowsClick" />
                                        <MenuItem Header="全选所有行" Click="OnSelectAllTerminalRowsClick" />
                                        <Separator />
                                        <MenuItem Header="导出表格 CSV" Click="OnExportTerminalTableCsvClick" />
                                    </ContextMenu>
                                </ListView.ContextMenu>
                                <ListView.ItemContainerStyle>
                                    <Style TargetType="ListViewItem">
                                        <Setter Property="MinHeight" Value="26" />
                                        <Setter Property="Padding" Value="3,0" />
                                        <Setter Property="Background" Value="Transparent" />
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                        <Setter Property="VerticalContentAlignment" Value="Center" />
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="ListViewItem">
                                                    <Border x:Name="ItemBorder"
                                                            MinHeight="{TemplateBinding MinHeight}"
                                                            Background="{TemplateBinding Background}"
                                                            SnapsToDevicePixels="True">
                                                        <Grid ClipToBounds="True">
                                                            <GridViewRowPresenter x:Name="RecordPresenter"
                                                                                  Margin="{TemplateBinding Padding}"
                                                                                  HorizontalAlignment="Stretch"
                                                                                  VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                                                                  Columns="{Binding View.Columns, RelativeSource={RelativeSource AncestorType=ListView}}"
                                                                                  Content="{TemplateBinding Content}" />
                                                            <Grid x:Name="SeparatorPresenter"
                                                                  Margin="8,0"
                                                                  IsHitTestVisible="False"
                                                                  Visibility="Collapsed">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="*" />
                                                                    <ColumnDefinition Width="Auto" />
                                                                    <ColumnDefinition Width="*" />
                                                                </Grid.ColumnDefinitions>
                                                                <TextBlock ClipToBounds="True"
                                                                           VerticalAlignment="Center"
                                                                           Foreground="{DynamicResource TerminalSeparatorBrush}"
                                                                           Text="{Binding DataContext.TerminalSeparatorFillText, RelativeSource={RelativeSource AncestorType=ListView}}"
                                                                           TextAlignment="Right"
                                                                           TextWrapping="NoWrap" />
                                                                <TextBlock Grid.Column="1"
                                                                           Margin="10,0"
                                                                           VerticalAlignment="Center"
                                                                           Foreground="{DynamicResource TerminalSeparatorBrush}"
                                                                           Text="{Binding SeparatorGapText}" />
                                                                <TextBlock Grid.Column="2"
                                                                           ClipToBounds="True"
                                                                           VerticalAlignment="Center"
                                                                           Foreground="{DynamicResource TerminalSeparatorBrush}"
                                                                           Text="{Binding DataContext.TerminalSeparatorFillText, RelativeSource={RelativeSource AncestorType=ListView}}"
                                                                           TextWrapping="NoWrap" />
                                                            </Grid>
                                                        </Grid>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource NavigationHoverBrush}" />
                                                        </Trigger>
                                                        <Trigger Property="IsSelected" Value="True">
                                                            <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource {x:Static SystemColors.HighlightBrushKey}}" />
                                                            <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.HighlightTextBrushKey}}" />
                                                        </Trigger>
                                                        <DataTrigger Binding="{Binding IsSeparator}" Value="True">
                                                            <Setter TargetName="RecordPresenter" Property="Visibility" Value="Collapsed" />
                                                            <Setter TargetName="SeparatorPresenter" Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </ListView.ItemContainerStyle>
                                <ListView.View>
                                    <GridView AllowsColumnReorder="False">
                                        <GridViewColumn x:Name="TerminalTimeColumn" Width="122" Header="时间">
                                            <GridViewColumn.CellTemplate>
                                                <DataTemplate>
                                                    <TextBox Style="{StaticResource TerminalCellTextBoxStyle}"
                                                             Foreground="{Binding RelativeSource={RelativeSource AncestorType=ListViewItem}, Path=Foreground}"
                                                             ToolTip="{Binding TimeText}"
                                                             Text="{Binding TimeText, Mode=OneWay}" />
                                                </DataTemplate>
                                            </GridViewColumn.CellTemplate>
                                        </GridViewColumn>
                                        <GridViewColumn x:Name="TerminalDirectionColumn" Width="84" Header="方向">
                                            <GridViewColumn.CellTemplate>
                                                <DataTemplate>
                                                    <TextBox Style="{StaticResource TerminalCellTextBoxStyle}"
                                                             Foreground="{Binding RelativeSource={RelativeSource AncestorType=ListViewItem}, Path=Foreground}"
                                                             ToolTip="{Binding DirectionText}"
                                                             Text="{Binding DirectionText, Mode=OneWay}" />
                                                </DataTemplate>
                                            </GridViewColumn.CellTemplate>
                                        </GridViewColumn>
                                        <GridViewColumn x:Name="TerminalEndpointColumn" Width="150" Header="端点">
                                            <GridViewColumn.CellTemplate>
                                                <DataTemplate>
                                                    <TextBox Style="{StaticResource TerminalCellTextBoxStyle}"
                                                             Foreground="{Binding RelativeSource={RelativeSource AncestorType=ListViewItem}, Path=Foreground}"
                                                             ToolTip="{Binding Endpoint}"
                                                             Text="{Binding Endpoint, Mode=OneWay}" />
                                                </DataTemplate>
                                            </GridViewColumn.CellTemplate>
                                        </GridViewColumn>
                                        <GridViewColumn x:Name="TerminalSizeColumn" Width="66" Header="字节">
                                            <GridViewColumn.CellTemplate>
                                                <DataTemplate>
                                                    <TextBox Style="{StaticResource TerminalCellTextBoxStyle}"
                                                             Foreground="{Binding RelativeSource={RelativeSource AncestorType=ListViewItem}, Path=Foreground}"
                                                             ToolTip="{Binding Size}"
                                                             Text="{Binding Size, Mode=OneWay}" />
                                                </DataTemplate>
                                            </GridViewColumn.CellTemplate>
                                        </GridViewColumn>
                                        <GridViewColumn x:Name="TerminalContentColumn" Width="760">
                                            <GridViewColumn.Header>
                                                <GridViewColumnHeader Content="内容" IsHitTestVisible="False" />
                                            </GridViewColumn.Header>
                                            <GridViewColumn.CellTemplate>
                                                <DataTemplate>
                                                    <TextBox Style="{StaticResource TerminalCellTextBoxStyle}"
                                                             Foreground="{Binding RelativeSource={RelativeSource AncestorType=ListViewItem}, Path=Foreground}">
                                                        <TextBox.Text>
                                                            <MultiBinding Mode="OneWay" Converter="{StaticResource TerminalDisplayTextConverter}">
                                                                <Binding />
                                                                <Binding Path="DataContext.ReceiveAsHex" RelativeSource="{RelativeSource AncestorType=Window}" />
                                                            </MultiBinding>
                                                        </TextBox.Text>
                                                    </TextBox>
                                                </DataTemplate>
                                            </GridViewColumn.CellTemplate>
                                        </GridViewColumn>
                                    </GridView>
                                </ListView.View>
                                            </ListView>
                                        </Border>
                                        <Border IsHitTestVisible="False"
                                                Panel.ZIndex="1"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                Padding="10"
                                                Background="{DynamicResource TerminalBackgroundBrush}"
                                                CornerRadius="5">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding TerminalRecords.Count}" Value="0">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <TextBlock Margin="0"
                                                            HorizontalAlignment="Center"
                                                            FontSize="11"
                                                           FontWeight="Normal"
                                                           Foreground="{DynamicResource MutedTextBrush}"
                                                           Text="暂无通信数据" />
                                            </StackPanel>
                                        </Border>
                                    </Grid>
                                </TabItem>
                            </TabControl>

                            <GridSplitter Grid.Row="2"
                                          Height="8"
                                          HorizontalAlignment="Stretch"
                                          VerticalAlignment="Center"
                                          Background="Transparent"
                                          Cursor="SizeNS"
                                          ResizeDirection="Rows"
                                          ResizeBehavior="PreviousAndNext"
                                          ShowsPreview="True"
                                          ToolTip="上下拖动调整发送栏高度">
                                <GridSplitter.Template>
                                    <ControlTemplate TargetType="GridSplitter">
                                        <Grid Background="Transparent">
                                            <Border Width="40"
                                                    Height="2"
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center"
                                                    Background="{DynamicResource MutedTextBrush}"
                                                    CornerRadius="1" />
                                        </Grid>
                                    </ControlTemplate>
                                </GridSplitter.Template>
                            </GridSplitter>

                            <Border Grid.Row="3"
                                    Padding="6"
                                    Background="{DynamicResource PanelBackgroundBrush}"
                                    BorderBrush="{DynamicResource DividerBrush}"
                                    BorderThickness="1"
                                    CornerRadius="4"
                                    TextElement.FontWeight="Normal">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="78" />
                                        <ColumnDefinition Width="72" />
                                        <ColumnDefinition Width="86" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Style="{StaticResource SendOptionLabelStyle}" Text="编码" />
                                    <TextBlock Grid.Column="1" Style="{StaticResource SendOptionLabelStyle}" Text="换行符" />
                                    <TextBlock Grid.Column="2" Style="{StaticResource SendOptionLabelStyle}" Text="校验" />
                                    <ComboBox Grid.Row="1" Grid.Column="0" Height="24" Margin="0,0,4,4" Style="{StaticResource ConnectionComboBoxStyle}" ItemsSource="{Binding EncodingNames}" SelectedItem="{Binding SelectedEncodingName}" />
                                    <ComboBox Grid.Row="1" Grid.Column="1" Height="24" Margin="0,0,4,4" Style="{StaticResource ConnectionComboBoxStyle}" ItemsSource="{Binding LineEndings}" SelectedItem="{Binding SelectedLineEnding}" />
                                    <ComboBox Grid.Row="1" Grid.Column="2" Height="24" Margin="0,0,4,4" Style="{StaticResource ConnectionComboBoxStyle}" ItemsSource="{Binding ChecksumKinds}" SelectedItem="{Binding SelectedSendChecksum}" />
                                    <WrapPanel Grid.Row="1" Grid.Column="3" Margin="0,0,4,4" HorizontalAlignment="Left" VerticalAlignment="Center">
                                        <ui:ToggleSwitch Height="24"
                                                         Margin="0,0,8,3"
                                                         FontSize="10"
                                                         FontWeight="Normal"
                                                         Foreground="{DynamicResource ButtonForegroundBrush}"
                                                         Content="HEX 发送"
                                                         IsChecked="{Binding SendAsHex}"
                                                         ToolTip="开启后按十六进制字节解析发送框内容" />
                                        <ui:ToggleSwitch Height="24"
                                                         Margin="0,0,4,3"
                                                         FontSize="10"
                                                         FontWeight="Normal"
                                                         Foreground="{DynamicResource ButtonForegroundBrush}"
                                                         Content="循环发送"
                                                         FocusVisualStyle="{x:Null}"
                                                         IsChecked="{Binding SendRepeatEnabled, Mode=TwoWay}"
                                                         ToolTip="启用循环发送；已连接且发送框非空时开始按间隔发送" />
                                        <TextBox Width="50"
                                                 Height="24"
                                                 Margin="0,0,2,3"
                                                 Style="{StaticResource ConnectionTextBoxStyle}"
                                                 FontSize="10"
                                                 HorizontalContentAlignment="Center"
                                                 Text="{Binding SendRepeatIntervalMs, UpdateSourceTrigger=PropertyChanged}"
                                                 ToolTip="循环发送间隔，单位 ms" />
                                        <TextBlock Margin="0,0,7,3"
                                                   VerticalAlignment="Center"
                                                   FontSize="10"
                                                   FontWeight="Normal"
                                                   Foreground="{DynamicResource ButtonForegroundBrush}"
                                                   Text="ms" />
                                         <StackPanel Margin="0,0,0,3" Orientation="Horizontal" VerticalAlignment="Center">
                                            <StackPanel.Style>
                                                <Style TargetType="StackPanel">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding SelectedTransportOption.Kind}" Value="Serial">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </StackPanel.Style>
                                            <TextBlock Margin="0,0,3,0"
                                                       VerticalAlignment="Center"
                                                       FontSize="10"
                                                       FontWeight="Normal"
                                                       Foreground="{DynamicResource ButtonForegroundBrush}"
                                                       Text="收包超时" />
                                            <TextBox Width="38"
                                                     Height="24"
                                                     Style="{StaticResource ConnectionTextBoxStyle}"
                                                     FontSize="10"
                                                     HorizontalContentAlignment="Center"
                                                     Text="{Binding ReceiveTimeoutMs, UpdateSourceTrigger=PropertyChanged}"
                                                     ToolTip="仅串口有效；不同底层读取在此间隔内合并为一条记录" />
                                            <TextBlock Margin="2,0,0,0"
                                                       VerticalAlignment="Center"
                                                       FontSize="10"
                                                       FontWeight="Normal"
                                                       Foreground="{DynamicResource ButtonForegroundBrush}"
                                                       Text="ms" />
                                        </StackPanel>
                                    </WrapPanel>
                                    <Button Grid.Row="1"
                                            Grid.Column="4"
                                            MinWidth="86"
                                            Height="26"
                                            Margin="6,0,0,4"
                                            HorizontalAlignment="Right"
                                            Style="{StaticResource RoundedButtonStyle}"
                                            ToolTip="选择并发送文件"
                                            Click="OnSendFileClick">
                                        <StackPanel Orientation="Horizontal">
                                            <ui:SymbolIcon Symbol="DocumentArrowUp20" Width="16" Height="16" Margin="0,0,5,0" />
                                            <TextBlock Text="发送文件" />
                                        </StackPanel>
                                    </Button>
                                    <TextBox Grid.Row="2"
                                             Grid.Column="0"
                                             Grid.ColumnSpan="4"
                                             MinHeight="52"
                                             Padding="7,5"
                                             AcceptsReturn="True"
                                             TextWrapping="Wrap"
                                             VerticalContentAlignment="Top"
                                             VerticalScrollBarVisibility="Auto"
                                             Style="{StaticResource CompactTextBoxStyle}"
                                             Text="{Binding SendText, UpdateSourceTrigger=PropertyChanged}" />
                                    <Button Grid.Row="2" Grid.Column="4" Height="52" Margin="6,0,0,0" VerticalAlignment="Bottom" Style="{StaticResource PrimaryButtonStyle}" Command="{Binding SendCommand}">
                                        <StackPanel Orientation="Horizontal">
                                            <ui:SymbolIcon Width="14" Height="14" Margin="0,0,3,0" Symbol="Send20" />
                                            <TextBlock Text="发送" />
                                        </StackPanel>
                                    </Button>
                                </Grid>
                            </Border>
                        </Grid>
                    </TabItem>

                    <TabItem Header="帧解析" Visibility="{Binding IsFrameWorkspaceVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Grid Margin="0,0,0,7">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <WrapPanel VerticalAlignment="Top">
                                    <StackPanel Width="86" Margin="0,0,4,0">
                                        <TextBlock Style="{StaticResource FrameOptionLabelStyle}" Text="方式" />
                                        <ComboBox Height="24"
                                                  MinHeight="24"
                                                  Padding="5,3"
                                                  FontSize="10"
                                                  Style="{StaticResource ConnectionComboBoxStyle}"
                                                  ItemsSource="{Binding FramingModes}"
                                                  DisplayMemberPath="Name"
                                                  SelectedValuePath="Mode"
                                                  SelectedValue="{Binding SelectedFramingMode, UpdateSourceTrigger=PropertyChanged}"
                                                  ToolTip="{Binding SelectedFramingModeDescription}" />
                                    </StackPanel>
                                    <StackPanel Width="72" Margin="0,0,4,0">
                                        <TextBlock Style="{StaticResource FrameOptionLabelStyle}" Text="分隔符 HEX" />
                                        <TextBox Height="24"
                                                 Style="{StaticResource ConnectionTextBoxStyle}"
                                                 Text="{Binding DelimiterHex}"
                                                 ToolTip="按十六进制输入结束标志，字节用空格分隔，例如 0D 0A；按行和分隔符模式使用。" />
                                    </StackPanel>
                                    <StackPanel Width="65" Margin="0,0,4,0">
                                        <TextBlock Style="{StaticResource FrameOptionLabelStyle}" Text="固定长度" />
                                        <TextBox Height="24"
                                                 Style="{StaticResource ConnectionTextBoxStyle}"
                                                 Text="{Binding FixedFrameLength}"
                                                 ToolTip="每 N 个字节组成一帧，例如填写 8；仅固定长度模式使用。" />
                                    </StackPanel>
                                    <StackPanel Width="65" Margin="0,0,4,0">
                                        <TextBlock Style="{StaticResource FrameOptionLabelStyle}" Text="长度偏移" />
                                        <TextBox Height="24"
                                                 Style="{StaticResource ConnectionTextBoxStyle}"
                                                 Text="{Binding LengthFieldOffset}"
                                                 ToolTip="长度字段从帧头第几个字节开始，0 表示首字节；仅长度字段模式使用。" />
                                    </StackPanel>
                                    <StackPanel Width="65" Margin="0,0,4,0">
                                        <TextBlock Style="{StaticResource FrameOptionLabelStyle}" Text="长度宽度" />
                                        <TextBox Height="24"
                                                 Style="{StaticResource ConnectionTextBoxStyle}"
                                                 Text="{Binding LengthFieldSize}"
                                                 ToolTip="长度字段占用的字节数，范围 1-4；仅长度字段模式使用。" />
                                    </StackPanel>
                                    <StackPanel Width="65" Margin="0,0,4,0">
                                        <TextBlock Style="{StaticResource FrameOptionLabelStyle}" Text="长度修正" />
                                        <TextBox Height="24"
                                                 Style="{StaticResource ConnectionTextBoxStyle}"
                                                 Text="{Binding LengthAdjustment}"
                                                 ToolTip="在长度字段计算结果上增加或减少的字节数；仅长度字段模式使用。" />
                                    </StackPanel>
                                    <StackPanel Width="68" Margin="0,0,4,0">
                                        <TextBlock Style="{StaticResource FrameOptionLabelStyle}" Text="空闲间隔" />
                                        <TextBox Height="24"
                                                 Style="{StaticResource ConnectionTextBoxStyle}"
                                                 Text="{Binding IdleGapMs}"
                                                 ToolTip="两次接收间隔超过该值就结束上一帧，例如 20；仅空闲间隔模式使用。" />
                                    </StackPanel>
                                    <Button Width="72"
                                            Height="24"
                                            MinHeight="24"
                                            Margin="0,16,0,0"
                                            Padding="9,2"
                                            FontSize="10"
                                            Command="{Binding ApplyFramingOptionsCommand}">应用分帧</Button>
                                </WrapPanel>
                                <TextBlock Grid.Row="1"
                                           Margin="2,3,0,0"
                                           FontSize="11"
                                           Foreground="{DynamicResource MutedTextBrush}"
                                           Text="{Binding SelectedFramingModeDescription}"
                                           TextWrapping="Wrap" />
                            </Grid>
                            <Grid Grid.Row="1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="1.55*" MinWidth="315" />
                                    <ColumnDefinition Width="7" />
                                    <ColumnDefinition Width="1*" MinWidth="155" />
                                </Grid.ColumnDefinitions>
                                <ListView x:Name="FrameList"
                                          ItemsSource="{Binding FrameRecords}"
                                          SelectionMode="Extended"
                                          SizeChanged="OnFrameListSizeChanged"
                                          ScrollViewer.ScrollChanged="OnFrameListScrollChanged"
                                          Background="{DynamicResource TerminalBackgroundBrush}"
                                          Foreground="{DynamicResource TerminalTextBrush}"
                                          BorderThickness="0"
                                          FontFamily="Cascadia Mono, Consolas"
                                          FontSize="{Binding TerminalFontSize}"
                                          ScrollViewer.CanContentScroll="True"
                                          ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                          VirtualizingPanel.IsVirtualizing="True"
                                          VirtualizingPanel.VirtualizationMode="Recycling">
                                    <ListView.Resources>
                                        <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="#315F58" />
                                        <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="#FFFFFF" />
                                        <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}" Color="#284C48" />
                                    </ListView.Resources>
                                    <ListView.ItemContainerStyle>
                                        <Style TargetType="ListViewItem">
                                            <Setter Property="MinHeight" Value="26" />
                                            <Setter Property="Padding" Value="3,0" />
                                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                            <Setter Property="VerticalContentAlignment" Value="Center" />
                                        </Style>
                                    </ListView.ItemContainerStyle>
                                    <ListView.View>
                                        <GridView AllowsColumnReorder="False">
                                            <GridViewColumn x:Name="FrameTimeColumn" Width="100" Header="时间">
                                                <GridViewColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <TextBox Style="{StaticResource TerminalCellTextBoxStyle}"
                                                                 Foreground="{Binding RelativeSource={RelativeSource AncestorType=ListViewItem}, Path=Foreground}"
                                                                 ToolTip="{Binding TimeText}"
                                                                 Text="{Binding TimeText, Mode=OneWay}" />
                                                    </DataTemplate>
                                                </GridViewColumn.CellTemplate>
                                            </GridViewColumn>
                                            <GridViewColumn x:Name="FrameLengthColumn" Width="56" Header="字节">
                                                <GridViewColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <TextBox Style="{StaticResource TerminalCellTextBoxStyle}"
                                                                 Foreground="{Binding RelativeSource={RelativeSource AncestorType=ListViewItem}, Path=Foreground}"
                                                                 ToolTip="{Binding Length}"
                                                                 Text="{Binding Length, Mode=OneWay}" />
                                                    </DataTemplate>
                                                </GridViewColumn.CellTemplate>
                                            </GridViewColumn>
                                            <GridViewColumn x:Name="FrameHexColumn" Width="360" Header="HEX">
                                                <GridViewColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <TextBox Style="{StaticResource TerminalCellTextBoxStyle}"
                                                                 Foreground="{Binding RelativeSource={RelativeSource AncestorType=ListViewItem}, Path=Foreground}"
                                                                 ToolTip="{Binding Hex}"
                                                                 Text="{Binding Hex, Mode=OneWay}" />
                                                    </DataTemplate>
                                                </GridViewColumn.CellTemplate>
                                            </GridViewColumn>
                                            <GridViewColumn x:Name="FrameSummaryColumn" Width="360" Header="字段 / 解析">
                                                <GridViewColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <TextBox Style="{StaticResource TerminalCellTextBoxStyle}"
                                                                 Foreground="{Binding RelativeSource={RelativeSource AncestorType=ListViewItem}, Path=Foreground}"
                                                                 ToolTip="{Binding Summary}"
                                                                 Text="{Binding Summary, Mode=OneWay}" />
                                                    </DataTemplate>
                                                </GridViewColumn.CellTemplate>
                                            </GridViewColumn>
                                        </GridView>
                                    </ListView.View>
                                </ListView>
                                <GridSplitter Grid.Column="1"
                                              Width="7"
                                              HorizontalAlignment="Stretch"
                                              VerticalAlignment="Stretch"
                                              Background="{DynamicResource DividerBrush}"
                                              Cursor="SizeWE"
                                              ResizeDirection="Columns"
                                              ResizeBehavior="PreviousAndNext"
                                              ShowsPreview="False"
                                              ToolTip="左右拖动调整帧表格与模板区域宽度" />
                                <Grid Grid.Column="2" Margin="8,0,0,0">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <TextBlock Style="{StaticResource SectionLabelStyle}"
                                               Text="设备帧模板 JSON（单对象或数组；按 MatchOffset/MatchHex 匹配，空 Match 为兜底）"
                                               TextWrapping="Wrap"
                                               ToolTip="多个模板共用上方分帧方式，按数组顺序先匹配有 MatchHex 的模板；字段可用 LengthFromOffset 和 OffsetFromLengthOffset 表达长度前缀内容。" />
                                    <TextBox Grid.Row="1"
                                             AcceptsReturn="True"
                                             AcceptsTab="True"
                                             FontFamily="Cascadia Mono, Consolas"
                                             FontSize="12"
                                             HorizontalScrollBarVisibility="Auto"
                                             VerticalScrollBarVisibility="Auto"
                                             Text="{Binding FrameTemplateJson, UpdateSourceTrigger=PropertyChanged}" />
                                    <StackPanel Grid.Row="2" Margin="0,7,0,0" HorizontalAlignment="Right" Orientation="Horizontal">
                                        <Button Margin="0,0,5,0" Padding="9,5" Click="OnImportFrameTemplateClick">导入</Button>
                                        <Button Margin="0,0,5,0" Padding="9,5" Click="OnExportFrameTemplateClick">导出</Button>
                                        <Button Padding="10,5" Command="{Binding ApplyFrameTemplateCommand}">校验并应用模板</Button>
                                    </StackPanel>
                                </Grid>
                            </Grid>
                        </Grid>
                    </TabItem>

                    <TabItem Header="曲线" Visibility="{Binding IsChartWorkspaceVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <DockPanel Margin="0,0,0,6">
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                    <Button Style="{StaticResource IconButtonStyle}" ToolTip="清空曲线" Click="OnClearChartClick">
                                        <ui:SymbolIcon Symbol="Delete20" />
                                    </Button>
                                    <Button Style="{StaticResource IconButtonStyle}" ToolTip="导出 PNG" Click="OnExportChartClick">
                                        <ui:SymbolIcon Symbol="Save20" />
                                    </Button>
                                    <Button Style="{StaticResource IconButtonStyle}" ToolTip="导出 CSV" Click="OnExportChartCsvClick">
                                        <ui:SymbolIcon Symbol="DocumentCsv20" />
                                    </Button>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <ui:ToggleSwitch Margin="0,0,8,0" Content="从文本提取数值" IsChecked="{Binding ChartAutoExtract}" />
                                    <TextBox Width="260" Style="{StaticResource CompactTextBoxStyle}" Text="{Binding ChartValuePattern, UpdateSourceTrigger=PropertyChanged}" ToolTip="数值正则表达式" />
                                </StackPanel>
                            </DockPanel>
                            <Border Grid.Row="1" Background="{DynamicResource PanelBackgroundBrush}" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="1" CornerRadius="4">
                                <scott:WpfPlot x:Name="RealtimePlot" />
                            </Border>
                        </Grid>
                    </TabItem>

                    <TabItem Header="Modbus" Visibility="{Binding IsModbusWorkspace, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <WrapPanel Margin="0,0,0,8">
                                <TextBlock Margin="0,0,4,0" VerticalAlignment="Center" Text="站号" />
                                <TextBox Width="55" Margin="0,0,8,0" Style="{StaticResource CompactTextBoxStyle}" Text="{Binding ModbusUnitId}" />
                                <ComboBox Width="150" Margin="0,0,8,0" VerticalContentAlignment="Stretch" ItemsSource="{Binding ModbusFunctions}" SelectedItem="{Binding SelectedModbusFunction}" />
                                <TextBlock Margin="0,0,4,0" VerticalAlignment="Center" Text="地址" />
                                <TextBox Width="70" Margin="0,0,8,0" Style="{StaticResource CompactTextBoxStyle}" Text="{Binding ModbusAddress}" />
                                <TextBlock Margin="0,0,4,0" VerticalAlignment="Center" Text="数量/值" />
                                <TextBox Width="75" Margin="0,0,8,0" Style="{StaticResource CompactTextBoxStyle}" Text="{Binding ModbusQuantityOrValue}" />
                                <TextBox Width="210" Margin="0,0,8,0" Style="{StaticResource CompactTextBoxStyle}" Text="{Binding ModbusValues}" ToolTip="多值使用逗号或空格分隔" />
                                <Button Style="{StaticResource PrimaryButtonStyle}" Command="{Binding SendModbusCommand}">
                                    <StackPanel Orientation="Horizontal">
                                        <ui:SymbolIcon Margin="0,0,6,0" Symbol="Send20" />
                                        <TextBlock Text="发送请求" />
                                    </StackPanel>
                                </Button>
                            </WrapPanel>
                            <Grid Grid.Row="1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="5" />
                                    <ColumnDefinition Width="270" />
                                </Grid.ColumnDefinitions>
                                <DataGrid ItemsSource="{Binding ModbusRegisters}" AutoGenerateColumns="False" CanUserAddRows="False" HeadersVisibility="Column" GridLinesVisibility="Horizontal">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Width="170" Header="寄存器地址" Binding="{Binding AddressText}" IsReadOnly="True" />
                                        <DataGridTextColumn Width="120" Header="值" Binding="{Binding Value, UpdateSourceTrigger=PropertyChanged}" />
                                        <DataGridTextColumn Width="120" Header="HEX" Binding="{Binding Value, StringFormat=0x{0:X4}}" IsReadOnly="True" />
                                    </DataGrid.Columns>
                                </DataGrid>
                                <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Stretch" />
                                <StackPanel Grid.Column="2" Margin="10,4">
                                    <TextBlock Style="{StaticResource SectionLabelStyle}" Text="从站模拟" />
                                    <ui:ToggleSwitch Content="启用 RTU/TCP 响应" IsChecked="{Binding ModbusSlaveEnabled}" />
                                    <TextBlock Margin="0,14,0,4" Style="{StaticResource SectionLabelStyle}" Text="事务编号" />
                                    <TextBox Style="{StaticResource CompactTextBoxStyle}" Text="{Binding ModbusTransactionId}" />
                                </StackPanel>
                            </Grid>
                        </Grid>
                    </TabItem>

                    <TabItem Header="BLE GATT" Visibility="{Binding IsBluetoothWorkspace, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <DockPanel Margin="0,0,0,8" LastChildFill="True">
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Foreground="{DynamicResource MutedTextBrush}" Text="{Binding BleDevices.Count, StringFormat=发现 {0} 个 BLE GATT 设备}" />
                                    <TextBlock Margin="0,3,12,0"
                                               Foreground="{DynamicResource ErrorBrush}"
                                               Text="{Binding BleDiscoveryNotice}"
                                               TextWrapping="Wrap" />
                                </StackPanel>
                            </DockPanel>
                            <Grid Grid.Row="1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="1.15*" />
                                    <ColumnDefinition Width="5" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="1.05*" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>
                                    <ListBox ItemsSource="{Binding BleDevices}" SelectedItem="{Binding SelectedBleDevice}" DisplayMemberPath="DisplayName" />
                                    <Button Grid.Row="1" Margin="0,7" Padding="10,5" HorizontalAlignment="Left" Command="{Binding BrowseGattCommand}">浏览所选设备 GATT</Button>
                                    <TreeView Grid.Row="2" ItemsSource="{Binding GattServices}" SelectedItemChanged="OnGattTreeSelectedItemChanged">
                                        <TreeView.Resources>
                                            <HierarchicalDataTemplate DataType="{x:Type infra:BleGattServiceInfo}" ItemsSource="{Binding Characteristics}">
                                                <TextBlock FontFamily="Cascadia Mono, Consolas" Text="{Binding DisplayName}" />
                                            </HierarchicalDataTemplate>
                                            <DataTemplate DataType="{x:Type infra:BleGattCharacteristicInfo}">
                                                <TextBlock Margin="12,0,0,0" FontFamily="Cascadia Mono, Consolas" Text="{Binding DisplayName}" />
                                            </DataTemplate>
                                        </TreeView.Resources>
                                    </TreeView>
                                </Grid>
                                <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Stretch" />
                                <StackPanel Grid.Column="2" Margin="12,4">
                                    <TextBlock Style="{StaticResource SectionLabelStyle}" Text="服务 UUID" />
                                    <TextBox Margin="0,0,0,10" Style="{StaticResource CompactTextBoxStyle}" Text="{Binding BleServiceUuid, UpdateSourceTrigger=PropertyChanged}" />
                                    <TextBlock Style="{StaticResource SectionLabelStyle}" Text="写特征值 UUID" />
                                    <TextBox Margin="0,0,0,10" Style="{StaticResource CompactTextBoxStyle}" Text="{Binding BleWriteUuid, UpdateSourceTrigger=PropertyChanged}" />
                                    <TextBlock Style="{StaticResource SectionLabelStyle}" Text="读特征值 UUID" />
                                    <DockPanel Margin="0,0,0,10">
                                        <Button DockPanel.Dock="Right" Margin="6,0,0,0" Padding="10,4" Command="{Binding ReadBleCommand}">读取</Button>
                                        <TextBox Style="{StaticResource CompactTextBoxStyle}"
                                                 ToolTip="仅点击“读取”时使用；留空会自动选择服务中支持 Read 的特征值。"
                                                 Text="{Binding BleReadUuid, UpdateSourceTrigger=PropertyChanged}" />
                                    </DockPanel>
                                    <TextBlock Style="{StaticResource SectionLabelStyle}" Text="通知特征值 UUID" />
                                    <TextBox Margin="0,0,0,10" Style="{StaticResource CompactTextBoxStyle}" Text="{Binding BleNotifyUuid, UpdateSourceTrigger=PropertyChanged}" />
                                    <TextBlock Margin="0,0,0,8"
                                               Foreground="{DynamicResource MutedTextBrush}"
                                               TextWrapping="Wrap"
                                               Text="读 UUID 不是连接必填项；通知 UUID 用于设备主动上报，写 UUID 用于发送。留空时会按特征值属性自动选择。" />
                                    <ui:ToggleSwitch Content="无响应写入" IsChecked="{Binding BleWriteWithoutResponse}" />
                                </StackPanel>
                            </Grid>
                        </Grid>
                    </TabItem>
                </TabControl>
            </Grid>

            <GridSplitter Grid.Column="3"
                          Width="5"
                          HorizontalAlignment="Stretch"
                          ResizeDirection="Columns"
                          ResizeBehavior="PreviousAndNext"
                          Cursor="SizeWE"
                          Background="Transparent"
                          ShowsPreview="True"
                          DragCompleted="OnCommandSplitterDragCompleted" />

            <Border x:Name="CommandPanelBorder"
                    Grid.Column="4"
                    ClipToBounds="True"
                    Background="{DynamicResource SidebarBackgroundBrush}"
                    BorderBrush="{DynamicResource DividerBrush}"
                    BorderThickness="1,0,0,0">
                <Grid>
                    <Grid.Style>
                        <Style TargetType="Grid">
                            <Setter Property="Margin" Value="8" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                                             Value="Compact">
                                    <Setter Property="Margin" Value="6" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Grid.Style>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <StackPanel Margin="2,0,2,8" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock VerticalAlignment="Center"
                                   Style="{StaticResource SectionLabelStyle}"
                                   FontSize="14"
                                   Margin="0,0,6,3"
                                   Text="快捷指令" />
                        <Button Style="{StaticResource IconButtonStyle}"
                                ToolTip="删除勾选的快捷指令"
                                Command="{Binding DeleteSelectedQuickCommandsCommand}">
                            <ui:SymbolIcon Symbol="Delete20" />
                        </Button>
                        <Button Style="{StaticResource IconButtonStyle}"
                                ToolTip="新增命令"
                                Command="{Binding AddQuickCommandCommand}">
                            <ui:SymbolIcon Symbol="Add20" />
                        </Button>
                        <ComboBox Width="108"
                                  Height="24"
                                  Margin="5,0,0,0"
                                  Padding="5,3"
                                  FontSize="10"
                                  VerticalContentAlignment="Stretch"
                                  FocusVisualStyle="{x:Null}"
                                  ItemsSource="{Binding QuickCommandDataFormats}"
                                  SelectedItem="{Binding SelectedQuickCommandDataFormat}"
                                  ToolTip="快捷指令发送数据格式" />
                        <ComboBox Width="96"
                                  Height="24"
                                  Margin="5,0,0,0"
                                  Padding="5,3"
                                  FontSize="10"
                                  VerticalContentAlignment="Stretch"
                                  FocusVisualStyle="{x:Null}"
                                  DisplayMemberPath="Name"
                                  ItemsSource="{Binding QuickCommandCategories}"
                                  SelectedItem="{Binding SelectedQuickCommandCategory}"
                                  ToolTip="当前快捷指令库；切换工作页时会自动切换" />
                    </StackPanel>

                    <Grid Grid.Row="1" Margin="0,0,0,5">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="150" />
                        </Grid.ColumnDefinitions>
                        <Grid Margin="0,0,6,0">
                            <TextBox Height="26"
                                     Padding="25,2,5,2"
                                     FontSize="11"
                                     VerticalContentAlignment="Center"
                                     Text="{Binding QuickCommandSearchText, UpdateSourceTrigger=PropertyChanged}"
                                     ToolTip="按名称或内容查找快捷命令" />
                            <ui:SymbolIcon Margin="7,0,0,0"
                                           HorizontalAlignment="Left"
                                           VerticalAlignment="Center"
                                           Symbol="Search20"
                                           IsHitTestVisible="False" />
                        </Grid>
                        <ComboBox Grid.Column="1"
                                  Height="26"
                                  MinHeight="26"
                                  Padding="5,3"
                                  FontSize="10"
                                  VerticalContentAlignment="Stretch"
                                  FocusVisualStyle="{x:Null}"
                                  ItemsSource="{Binding QuickCommandSortOptions}"
                                  SelectedItem="{Binding SelectedQuickCommandSort}"
                                  ToolTip="快捷命令排序方式" />
                    </Grid>


                    <ListBox x:Name="QuickCommandsList"
                             Grid.Row="2"
                             ItemsSource="{Binding QuickCommandsView}"
                             SelectedItem="{Binding SelectedQuickCommand, Mode=TwoWay}"
                             AllowDrop="True"
                             PreviewMouseLeftButtonDown="OnQuickCommandPreviewMouseLeftButtonDown"
                             PreviewMouseMove="OnQuickCommandPreviewMouseMove"
                             GiveFeedback="OnQuickCommandGiveFeedback"
                             PreviewDragOver="OnQuickCommandDragOver"
                             PreviewDragLeave="OnQuickCommandDragLeave"
                             PreviewDrop="OnQuickCommandDrop"
                              PreviewMouseWheel="OnQuickCommandsListPreviewMouseWheel"
                              Margin="0,0,0,3"
                              Background="{DynamicResource QuickCommandListCanvasBrush}"
                             BorderBrush="{DynamicResource DividerBrush}"
                             BorderThickness="1"
                             ScrollViewer.CanContentScroll="True"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                             VirtualizingPanel.CacheLength="0.5,0.5"
                             VirtualizingPanel.CacheLengthUnit="Page"
                             VirtualizingPanel.IsVirtualizing="True"
                              VirtualizingPanel.IsVirtualizingWhenGrouping="True"
                              VirtualizingPanel.ScrollUnit="Pixel"
                              VirtualizingPanel.VirtualizationMode="Recycling">
                        <ListBox.Style>
                            <Style TargetType="ListBox">
                                <Setter Property="Padding" Value="3" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                                                 Value="Compact">
                                        <Setter Property="Padding" Value="2" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ListBox.Style>
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="MinHeight" Value="36" />
                                <Setter Property="Margin" Value="0,1,18,1" />
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="Background" Value="Transparent" />
                                <Setter Property="BorderBrush" Value="Transparent" />
                                <Setter Property="BorderThickness" Value="1" />
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="VerticalContentAlignment" Value="Stretch" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Grid>
                                                <Border x:Name="ItemBorder"
                                                        Background="{TemplateBinding Background}"
                                                        BorderBrush="{TemplateBinding BorderBrush}"
                                                        BorderThickness="{TemplateBinding BorderThickness}"
                                                        CornerRadius="4"
                                                        SnapsToDevicePixels="True">
                                                    <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                                      VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                                                      ContentTemplate="{TemplateBinding ContentTemplate}" />
                                                </Border>
                                                <Border Height="3"
                                                        Panel.ZIndex="1000"
                                                        VerticalAlignment="Top"
                                                        Background="{DynamicResource ButtonForegroundBrush}"
                                                        Visibility="{Binding IsDropTarget, Converter={StaticResource BooleanToVisibilityConverter}}"
                                                        IsHitTestVisible="False" />
                                                <Border Height="3"
                                                        Panel.ZIndex="1000"
                                                        VerticalAlignment="Bottom"
                                                        Background="{DynamicResource ButtonForegroundBrush}"
                                                        Visibility="{Binding IsDropTargetAfter, Converter={StaticResource BooleanToVisibilityConverter}}"
                                                        IsHitTestVisible="False" />
                                            </Grid>
                                            <ControlTemplate.Triggers>
                                                <MultiDataTrigger>
                                                    <MultiDataTrigger.Conditions>
                                                        <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource Self}}" Value="True" />
                                                        <Condition Binding="{Binding Tag, RelativeSource={RelativeSource AncestorType=ListBox}}" Value="{x:Null}" />
                                                    </MultiDataTrigger.Conditions>
                                                    <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource ButtonSurfaceBrush}" />
                                                    <Setter TargetName="ItemBorder" Property="BorderBrush" Value="{DynamicResource DividerBrush}" />
                                                </MultiDataTrigger>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource ButtonSurfaceBrush}" />
                                                    <Setter TargetName="ItemBorder" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                                                 Value="Compact">
                                        <Setter Property="Margin" Value="0,1,14,1" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid MinHeight="34">
                                    <Border Padding="2">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="28" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="{Binding NameColumnWidth, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" MinWidth="64" />
                                                <ColumnDefinition Width="8" />
                                                <ColumnDefinition Width="{Binding PayloadColumnWidth, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" MinWidth="56" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <CheckBox Grid.Column="0"
                                                      Width="24"
                                                      MinWidth="24"
                                                      Height="24"
                                                      Padding="0"
                                                      HorizontalAlignment="Center"
                                                      VerticalAlignment="Center"
                                                      FocusVisualStyle="{x:Null}"
                                                      IsChecked="{Binding IsSelectedForBulkDelete}"
                                                      ToolTip="勾选后可批量删除" />
                                            <TextBox Grid.Column="1"
                                                     x:Name="QuickCommandNameTextBox"
                                                     Height="24"
                                                     Margin="0,0,2,1"
                                                     Padding="4,2"
                                                     FocusVisualStyle="{x:Null}"
                                                     FontSize="11"
                                                     FontWeight="Normal"
                                                     VerticalContentAlignment="Center"
                                                     Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                                                     PreviewMouseLeftButtonDown="OnQuickCommandNamePreviewMouseLeftButtonDown"
                                                     ToolTip="快捷命令名称" />
                                            <Thumb Grid.Column="2"
                                                   Width="8"
                                                   HorizontalAlignment="Stretch"
                                                   VerticalAlignment="Stretch"
                                                   Cursor="SizeWE"
                                                   DragDelta="OnQuickCommandColumnSplitterDragDelta"
                                                   ToolTip="拖动调整本行名称与指令内容宽度">
                                                <Thumb.Template>
                                                    <ControlTemplate TargetType="Thumb">
                                                        <Grid Background="Transparent">
                                                            <Border x:Name="SplitterLine"
                                                                    Width="1"
                                                                    Height="18"
                                                                    HorizontalAlignment="Center"
                                                                    VerticalAlignment="Center"
                                                                    Background="{DynamicResource DividerBrush}"
                                                                    CornerRadius="1" />
                                                        </Grid>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter TargetName="SplitterLine" Property="Background" Value="{DynamicResource AccentBrush}" />
                                                            </Trigger>
                                                            <Trigger Property="IsDragging" Value="True">
                                                                <Setter TargetName="SplitterLine" Property="Width" Value="2" />
                                                                <Setter TargetName="SplitterLine" Property="Background" Value="{DynamicResource AccentBrush}" />
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Thumb.Template>
                                             </Thumb>
                                             <TextBox Grid.Column="3"
                                                     x:Name="QuickCommandPayloadTextBox"
                                                     Height="24"
                                                     Margin="2,0,3,1"
                                                     Padding="4,2"
                                                     FocusVisualStyle="{x:Null}"
                                                     FontFamily="Cascadia Mono, Consolas"
                                                     FontSize="11"
                                                     VerticalContentAlignment="Center"
                                                     Text="{Binding Payload, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                      PreviewMouseLeftButtonDown="OnQuickCommandPayloadPreviewMouseLeftButtonDown"
                                                      ToolTip="{Binding Payload}" />
                                            <Button Grid.Column="4"
                                                     Style="{StaticResource QuickCommandActionButtonStyle}"
                                                     ToolTip="发送"
                                                    Command="{Binding DataContext.SendQuickCommandCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}">
                                                <ui:SymbolIcon Symbol="Send20"
                                                               Style="{StaticResource QuickCommandActionIconStyle}"
                                                               HorizontalAlignment="Center"
                                                               VerticalAlignment="Center" />
                                            </Button>


                                            <Grid Grid.Row="1"
                                                  Grid.Column="0"
                                                  Grid.ColumnSpan="5"
                                                   Height="28"
                                                  Margin="0,3,0,0"
                                                  HorizontalAlignment="Stretch">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="54" />
                                                    <ColumnDefinition Width="64" />
                                                    <ColumnDefinition Width="68" />
                                                    <ColumnDefinition Width="*" MinWidth="68" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                 <Button Grid.Column="0"
                                                         Command="{Binding DataContext.ToggleQuickCommandPinCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding}">
                                                    <Button.Style>
                                                         <Style TargetType="Button" BasedOn="{StaticResource QuickCommandActionButtonStyle}">
                                                            <Setter Property="ToolTip" Value="置顶指令" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsPinned}" Value="True">
                                                                    <Setter Property="ToolTip" Value="取消置顶" />
                                                                    <Setter Property="Background" Value="{DynamicResource AccentSubtleBrush}" />
                                                                    <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                                                    <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Button.Style>
                                                      <ui:SymbolIcon>
                                                        <ui:SymbolIcon.Style>
                                                            <Style TargetType="ui:SymbolIcon" BasedOn="{StaticResource QuickCommandActionIconStyle}">
                                                                <Setter Property="Symbol" Value="Pin20" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsPinned}" Value="True">
                                                                        <Setter Property="Symbol" Value="PinOff20" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </ui:SymbolIcon.Style>
                                                    </ui:SymbolIcon>
                                                </Button>
                                                <Grid Grid.Column="1" ToolTip="按指令格式下勾选表示按 HEX 字节解析；切换不会改写指令内容">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="28" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <CheckBox Width="24"
                                                              MinWidth="24"
                                                              Height="24"
                                                              Padding="0"
                                                              HorizontalAlignment="Center"
                                                              VerticalAlignment="Center"
                                                              FocusVisualStyle="{x:Null}"
                                                              IsChecked="{Binding IsHex}" />
                                                    <TextBlock Grid.Column="1"
                                                               VerticalAlignment="Center"
                                                               FontSize="10"
                                                               Foreground="{DynamicResource ButtonForegroundBrush}"
                                                               Text="HEX"
                                                               IsHitTestVisible="False" />
                                                </Grid>
                                                  <ComboBox Grid.Column="2"
                                                          MinWidth="0"
                                                          Style="{StaticResource ConnectionComboBoxStyle}"
                                                          Margin="1,0"
                                                          Padding="2,3"
                                                          FontSize="10"
                                                          FocusVisualStyle="{x:Null}"
                                                          ItemsSource="{Binding DataContext.LineEndings, RelativeSource={RelativeSource AncestorType=Window}}"
                                                          SelectedItem="{Binding LineEnding}"
                                                          ToolTip="行尾追加方式" />
                                                  <ComboBox Grid.Column="3"
                                                          MinWidth="0"
                                                          Style="{StaticResource ConnectionComboBoxStyle}"
                                                          Margin="1,0"
                                                          Padding="2,3"
                                                          FontSize="10"
                                                          FocusVisualStyle="{x:Null}"
                                                          ItemsSource="{Binding DataContext.ChecksumKinds, RelativeSource={RelativeSource AncestorType=Window}}"
                                                          SelectedItem="{Binding Checksum}"
                                                          ToolTip="自动追加校验" />
                                                  <StackPanel Grid.Column="4"
                                                              Height="26"
                                                              Margin="1,0"
                                                              HorizontalAlignment="Left"
                                                              VerticalAlignment="Center"
                                                              Orientation="Horizontal">
                                                    <TextBox Width="50"
                                                             Height="26"
                                                             MinHeight="0"
                                                             Padding="0"
                                                             FontSize="10"
                                                             HorizontalContentAlignment="Center"
                                                             VerticalContentAlignment="Center"
                                                             TextAlignment="Center"
                                                             MaxLength="5"
                                                             Validation.ErrorTemplate="{x:Null}"
                                                             Text="{Binding RepeatIntervalText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                             LostKeyboardFocus="OnQuickCommandRepeatIntervalLostKeyboardFocus"
                                                             ToolTip="快捷指令循环发送间隔，范围 10~60000 ms" />
                                                    <TextBlock Margin="4,0,6,0"
                                                               HorizontalAlignment="Left"
                                                               VerticalAlignment="Center"
                                                               FontSize="10"
                                                               Foreground="{DynamicResource MutedTextBrush}"
                                                               Text="ms" />
                                                </StackPanel>
                                                  <Button Grid.Column="5"
                                                         Style="{StaticResource QuickCommandActionButtonStyle}"
                                                        ToolTip="开始或停止快捷指令循环发送"
                                                        ToolTipService.ShowOnDisabled="True"
                                                        ToolTipService.InitialShowDelay="200"
                                                        ToolTipService.ShowDuration="5000"
                                                        Command="{Binding DataContext.ToggleQuickRepeatCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding}">
                                                    <ui:SymbolIcon>
                                                        <ui:SymbolIcon.Style>
                                                            <Style TargetType="ui:SymbolIcon" BasedOn="{StaticResource QuickCommandActionIconStyle}">
                                                                <Setter Property="Symbol" Value="ArrowRepeatAll20" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsRepeating}" Value="True">
                                                                        <Setter Property="Symbol" Value="Pause20" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </ui:SymbolIcon.Style>
                                                    </ui:SymbolIcon>
                                                </Button>
                                                  <Button x:Name="QuickCommandDragHandle"
                                                          Grid.Column="6"
                                                         Style="{StaticResource QuickCommandActionButtonStyle}"
                                                        Cursor="SizeAll"
                                                        Focusable="False"
                                                        ToolTip="按住拖动调整顺序">
                                                     <ui:SymbolIcon Symbol="ArrowMove20"
                                                                    Style="{StaticResource QuickCommandActionIconStyle}" />
                                                </Button>
                                                  <Button Grid.Column="7"
                                                         Style="{StaticResource QuickCommandActionButtonStyle}"
                                                        ToolTip="删除"
                                                        Command="{Binding DataContext.DeleteQuickCommandCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding}">
                                                     <ui:SymbolIcon Symbol="Delete20"
                                                                    Style="{StaticResource QuickCommandActionIconStyle}" />
                                                </Button>
                                                  <Button x:Name="QuickCommandEditorToggleButton"
                                                           Grid.Column="8"
                                                         Click="OnToggleQuickCommandEditorClick">
                                                     <Button.Style>
                                                         <Style TargetType="Button" BasedOn="{StaticResource QuickCommandActionButtonStyle}">
                                                            <Setter Property="ToolTip" Value="展开快捷参数" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsExpanded}" Value="True">
                                                                    <Setter Property="ToolTip" Value="收起快捷参数" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Button.Style>
                                                     <ui:SymbolIcon>
                                                         <ui:SymbolIcon.Style>
                                                             <Style TargetType="ui:SymbolIcon" BasedOn="{StaticResource QuickCommandActionIconStyle}">
                                                                <Setter Property="Symbol" Value="ChevronDown20" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsExpanded}" Value="True">
                                                                        <Setter Property="Symbol" Value="ChevronUp20" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </ui:SymbolIcon.Style>
                                                    </ui:SymbolIcon>
                                                </Button>
                                            </Grid>
                                        </Grid>
                                    </Border>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                        <Grid x:Name="QuickCommandEditorHost"
                          Grid.Row="3"
                          Margin="0,3,0,2"
                              Height="0"
                              MaxHeight="360"
                          Opacity="0"
                          Visibility="Collapsed"
                          ClipToBounds="True"
                          Background="{DynamicResource QuickCommandEditorBrush}"
                          DataContext="{Binding SelectedQuickCommand}">
                        <Border Margin="0"
                                Background="{DynamicResource QuickCommandEditorBrush}"
                                BorderBrush="{DynamicResource QuickCommandEditorBorderBrush}"
                                BorderThickness="1,2,1,1"
                                CornerRadius="7"
                                Effect="{StaticResource QuickCommandEditorShadowEffect}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="34" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <Border Grid.Row="0"
                                        Padding="9,0"
                                        Background="{DynamicResource QuickCommandEditorHeaderBrush}"
                                        BorderBrush="{DynamicResource QuickCommandEditorBorderBrush}"
                                        BorderThickness="0,0,0,1">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock VerticalAlignment="Center"
                                                   FontSize="12"
                                                   FontWeight="SemiBold"
                                                   Text="指令编辑" />
                                        <TextBlock Grid.Column="1"
                                                   Margin="9,0,0,0"
                                                   VerticalAlignment="Center"
                                                   Foreground="{DynamicResource MutedTextBrush}"
                                                   FontSize="11"
                                                   Text="{Binding Name, StringFormat=当前：{0}}"
                                                   TextTrimming="CharacterEllipsis" />
                                    </Grid>
                                </Border>
                                <ScrollViewer Grid.Row="1"
                                              Margin="0"
                                              VerticalScrollBarVisibility="Auto"
                                              HorizontalScrollBarVisibility="Disabled">
                                    <Border Margin="8,8,8,8"
                                            Padding="0"
                                            Background="{DynamicResource QuickCommandEditorSectionBrush}"
                                            BorderBrush="{DynamicResource DividerBrush}"
                                            BorderThickness="1"
                                            CornerRadius="5">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>

                                        <Border Padding="7,5,7,4"
                                                BorderBrush="{DynamicResource DividerBrush}"
                                                BorderThickness="0">
                                            <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="60" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock VerticalAlignment="Center" FontSize="10" Text="指令模板" />
                                            <TextBox Grid.Column="1"
                                                     Height="24"
                                                     Style="{StaticResource ConnectionTextBoxStyle}"
                                                     FontFamily="Cascadia Mono, Consolas"
                                                     FontSize="11"
                                                     Text="{Binding Template, UpdateSourceTrigger=PropertyChanged}"
                                                     ToolTip="无变量占位符时直接发送此处输入的固定指令；变量格式为 ${name}" />
                                            </Grid>
                                        </Border>

                                        <Border Grid.Row="1"
                                                Padding="7,2"
                                                BorderBrush="{DynamicResource DividerBrush}"
                                                BorderThickness="0,0,0,1">
                                            <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="60" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="28" />
                                                <ColumnDefinition Width="28" />
                                                <ColumnDefinition Width="32" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock VerticalAlignment="Center" FontSize="10" Text="变量方案" />
                                                     <ListBox Grid.Column="1"
                                                      Height="44"
                                                      Margin="0,2,0,0"
                                                     ItemsSource="{Binding VariableSets}"
                                                     SelectedItem="{Binding SelectedVariableSet, Mode=TwoWay}"
                                                     SelectionMode="Single"
                                                     BorderThickness="0"
                                                     Background="Transparent"
                                                     PreviewMouseLeftButtonDown="OnQuickVariableSetPreviewMouseLeftButtonDown"
                                                     ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                                     ScrollViewer.VerticalScrollBarVisibility="Disabled">
                                                <ListBox.Template>
                                                    <ControlTemplate TargetType="ListBox">
                                                        <ScrollViewer Style="{StaticResource SeparatedHorizontalScrollViewerStyle}"
                                                                      Focusable="False"
                                                                      HorizontalScrollBarVisibility="Auto"
                                                                      VerticalScrollBarVisibility="Disabled">
                                                            <ItemsPresenter />
                                                        </ScrollViewer>
                                                    </ControlTemplate>
                                                </ListBox.Template>
                                                <ListBox.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <StackPanel Orientation="Horizontal" />
                                                    </ItemsPanelTemplate>
                                                </ListBox.ItemsPanel>
                                                <ListBox.ItemContainerStyle>
                                                    <Style TargetType="ListBoxItem">
                                                        <Setter Property="Height" Value="28" />
                                                         <Setter Property="MinWidth" Value="64" />
                                                         <Setter Property="Margin" Value="0,0,2,0" />
                                                        <Setter Property="Padding" Value="2,0" />
                                                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                                        <Setter Property="VerticalContentAlignment" Value="Stretch" />
                                                        <Setter Property="Background" Value="{DynamicResource ButtonSurfaceBrush}" />
                                                        <Setter Property="Foreground" Value="{DynamicResource ButtonForegroundBrush}" />
                                                        <Setter Property="BorderBrush" Value="{DynamicResource DividerBrush}" />
                                                        <Setter Property="BorderThickness" Value="1" />
                                                        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                                                        <Setter Property="Template">
                                                            <Setter.Value>
                                                                <ControlTemplate TargetType="ListBoxItem">
                                                                    <Border x:Name="SchemeBorder"
                                                                            Padding="{TemplateBinding Padding}"
                                                                            Background="{TemplateBinding Background}"
                                                                            BorderBrush="{TemplateBinding BorderBrush}"
                                                                            BorderThickness="{TemplateBinding BorderThickness}"
                                                                            CornerRadius="4">
                                                                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                                                                    </Border>
                                                                    <ControlTemplate.Triggers>
                                                                        <Trigger Property="IsMouseOver" Value="True">
                                                                            <Setter TargetName="SchemeBorder" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                                                        </Trigger>
                                                                        <Trigger Property="IsSelected" Value="True">
                                                                            <Setter TargetName="SchemeBorder" Property="Background" Value="{DynamicResource ButtonSurfaceBrush}" />
                                                                            <Setter TargetName="SchemeBorder" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                                                            <Setter Property="Foreground" Value="{DynamicResource ButtonForegroundBrush}" />
                                                                        </Trigger>
                                                                        <DataTrigger Binding="{Binding IsRenaming}" Value="True">
                                                                            <Setter TargetName="SchemeBorder" Property="Background" Value="{DynamicResource ButtonSurfaceBrush}" />
                                                                            <Setter TargetName="SchemeBorder" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                                                            <Setter Property="Foreground" Value="{DynamicResource ButtonForegroundBrush}" />
                                                                        </DataTrigger>
                                                                    </ControlTemplate.Triggers>
                                                                </ControlTemplate>
                                                            </Setter.Value>
                                                        </Setter>
                                                    </Style>
                                                </ListBox.ItemContainerStyle>
                                                <ListBox.ItemTemplate>
                                                    <DataTemplate>
                                                         <Grid MinWidth="56" Height="24">
                                                             <TextBlock HorizontalAlignment="Center"
                                                                        VerticalAlignment="Center"
                                                                        FontSize="11"
                                                                        Text="{Binding Name}"
                                                                        TextTrimming="CharacterEllipsis"
                                                                        ToolTip="{Binding Name}">
                                                                <TextBlock.Style>
                                                                    <Style TargetType="TextBlock">
                                                                        <Setter Property="Visibility" Value="Visible" />
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding IsRenaming}" Value="True">
                                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </TextBlock.Style>
                                                            </TextBlock>
                                                            <TextBox x:Name="QuickVariableSetNameTextBox"
                                                                      MinWidth="56"
                                                                     Height="24"
                                                                     Padding="4,1"
                                                                     HorizontalContentAlignment="Center"
                                                                     FontSize="11"
                                                                     Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                                                                     PreviewKeyDown="OnQuickVariableSetNamePreviewKeyDown"
                                                                     LostKeyboardFocus="OnQuickVariableSetNameLostKeyboardFocus">
                                                                <TextBox.Style>
                                                                    <Style TargetType="TextBox" BasedOn="{StaticResource ConnectionTextBoxStyle}">
                                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                                        <Setter Property="SelectionBrush" Value="{DynamicResource AccentSoftBrush}" />
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding IsRenaming}" Value="True">
                                                                                <Setter Property="Visibility" Value="Visible" />
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </TextBox.Style>
                                                            </TextBox>
                                                        </Grid>
                                                    </DataTemplate>
                                                </ListBox.ItemTemplate>
                                            </ListBox>
                                            <Button Grid.Column="2"
                                                    Style="{StaticResource CompactIconButtonStyle}"
                                                    Margin="0"
                                                    ToolTip="复制当前方案"
                                                    Command="{Binding DataContext.DuplicateQuickCommandVariableSetCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding SelectedVariableSet}">
                                                <ui:SymbolIcon Symbol="Copy20" Width="14" Height="14" />
                                            </Button>
                                            <Button Grid.Column="3"
                                                    Style="{StaticResource CompactIconButtonStyle}"
                                                    Margin="0"
                                                    ToolTip="删除当前方案；至少保留一个默认方案"
                                                    Command="{Binding DataContext.DeleteQuickCommandVariableSetCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding SelectedVariableSet}">
                                                <ui:SymbolIcon Symbol="Delete20" Width="14" Height="14" />
                                            </Button>
                                            <Button Grid.Column="4"
                                                    Style="{StaticResource CompactIconButtonStyle}"
                                                    Width="28"
                                                    MinWidth="0"
                                                    Height="28"
                                                    MinHeight="0"
                                                    Margin="2,0"
                                                    Command="{Binding DataContext.AddQuickCommandVariableSetCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}"
                                                    ToolTip="新建方案">
                                                <ui:SymbolIcon Symbol="Add20" Width="14" Height="14" />
                                            </Button>
                                            </Grid>
                                        </Border>

                                        <Border Grid.Row="2"
                                                Margin="8,6,8,0"
                                                BorderBrush="{DynamicResource DividerBrush}"
                                                BorderThickness="1">
                                            <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="24" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                                <Grid Background="{DynamicResource QuickCommandEditorHeaderBrush}">
                                                    <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="1.1*" />
                                                    <ColumnDefinition Width="1.5*" />
                                                    <ColumnDefinition Width="28" />
                                                    <ColumnDefinition Width="1.1*" />
                                                    <ColumnDefinition Width="1.5*" />
                                                    <ColumnDefinition Width="28" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Margin="6,0" VerticalAlignment="Center" FontSize="11" TextAlignment="Center" Text="变量" />
                                                <TextBlock Grid.Column="1" Margin="6,0" VerticalAlignment="Center" FontSize="11" TextAlignment="Center" Text="值" />
                                                <TextBlock Grid.Column="3" Margin="6,0" VerticalAlignment="Center" FontSize="11" TextAlignment="Center" Text="变量" />
                                                <TextBlock Grid.Column="4" Margin="6,0" VerticalAlignment="Center" FontSize="11" TextAlignment="Center" Text="值" />
                                            </Grid>
                                            <ListBox Grid.Row="1"
                                                     MaxHeight="116"
                                                     ItemsSource="{Binding SelectedVariableSet.Variables}"
                                                     BorderThickness="0"
                                                     Background="{DynamicResource ButtonSurfaceBrush}"
                                                     AlternationCount="2"
                                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                                     ScrollViewer.VerticalScrollBarVisibility="Auto">
                                                <ListBox.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <UniformGrid Columns="2" />
                                                    </ItemsPanelTemplate>
                                                </ListBox.ItemsPanel>
                                                <ListBox.ItemContainerStyle>
                                                    <Style TargetType="ListBoxItem">
                                                        <Setter Property="Padding" Value="0" />
                                                        <Setter Property="Margin" Value="0" />
                                                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                                        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                                                    </Style>
                                                </ListBox.ItemContainerStyle>
                                                <ListBox.ItemTemplate>
                                                    <DataTemplate>
                                                        <Grid Height="30" Margin="1">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="1.35*" />
                                                                <ColumnDefinition Width="28" />
                                                            </Grid.ColumnDefinitions>
                                                            <TextBox Height="26"
                                                                     Margin="2"
                                                                     Style="{StaticResource ConnectionTextBoxStyle}"
                                                                     FontFamily="Cascadia Mono, Consolas"
                                                                     Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                                                                     PreviewMouseLeftButtonDown="OnQuickVariablePreviewMouseLeftButtonDown" />
                                                            <TextBox Grid.Column="1"
                                                                     Height="26"
                                                                     Margin="2"
                                                                     Style="{StaticResource ConnectionTextBoxStyle}"
                                                                     FontFamily="Cascadia Mono, Consolas"
                                                                     Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}"
                                                                     PreviewMouseLeftButtonDown="OnQuickVariablePreviewMouseLeftButtonDown" />
                                                            <Button Grid.Column="2"
                                                                    Style="{StaticResource CompactIconButtonStyle}"
                                                                    Width="24"
                                                                    MinWidth="0"
                                                                    Height="26"
                                                                    MinHeight="0"
                                                                    Margin="2"
                                                                    ToolTip="删除本行变量"
                                                                    Command="{Binding DataContext.DeleteQuickCommandVariableCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                    CommandParameter="{Binding}">
                                                                <ui:SymbolIcon Symbol="Delete20" Width="13" Height="13" />
                                                            </Button>
                                                        </Grid>
                                                    </DataTemplate>
                                                </ListBox.ItemTemplate>
                                            </ListBox>
                                            <TextBlock Grid.Row="1"
                                                       Height="38"
                                                       Padding="8,0"
                                                       VerticalAlignment="Center"
                                                       Foreground="{DynamicResource MutedTextBrush}"
                                                       FontSize="11"
                                                       Text="当前为固定指令，发送时直接使用指令模板中的内容。">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                        <Style.Triggers>
                                                            <MultiDataTrigger>
                                                                <MultiDataTrigger.Conditions>
                                                                    <Condition Binding="{Binding IsDirectPayloadMode}" Value="True" />
                                                                    <Condition Binding="{Binding HasSelectedVariables}" Value="False" />
                                                                </MultiDataTrigger.Conditions>
                                                                <Setter Property="Visibility" Value="Visible" />
                                                            </MultiDataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                            </Grid>
                                        </Border>

                                        <Button Grid.Row="3"
                                                Margin="8,6,8,5"
                                                Padding="5,2"
                                                HorizontalAlignment="Left"
                                                FontSize="11"
                                                Command="{Binding DataContext.AddQuickCommandVariableCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding SelectedVariableSet}">
                                            <StackPanel Orientation="Horizontal">
                                                <ui:SymbolIcon Symbol="Add20" Width="14" Height="14" Margin="0,0,4,0" />
                                                <TextBlock Text="添加变量" />
                                            </StackPanel>
                                        </Button>

                                        <Border Grid.Row="4"
                                                Padding="8,6"
                                                BorderBrush="{DynamicResource DividerBrush}"
                                                BorderThickness="0">
                                            <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="68" />
                                                <ColumnDefinition Width="220" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock VerticalAlignment="Center" FontSize="11" Text="发送预览" />
                                            <TextBox Grid.Column="1"
                                                     Height="28"
                                                     Style="{StaticResource ConnectionTextBoxStyle}"
                                                     IsReadOnly="True"
                                                     FontFamily="Cascadia Mono, Consolas"
                                                     Text="{Binding ResolvedPayload, Mode=OneWay}" />
                                            <Button Grid.Column="2"
                                                    Width="32"
                                                    Height="28"
                                                    Margin="4,0,0,0"
                                                    HorizontalAlignment="Left"
                                                    Style="{StaticResource PrimaryButtonStyle}"
                                                    MinWidth="0"
                                                    Padding="0"
                                                    ToolTip="使用此方案发送"
                                                    Command="{Binding DataContext.SendQuickCommandCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}">
                                                <ui:SymbolIcon Symbol="Send20" Width="14" Height="14" />
                                            </Button>
                                            <Button Grid.Column="3"
                                                    Width="32"
                                                    Height="28"
                                                    Margin="2,0,0,0"
                                                    HorizontalAlignment="Left"
                                                    Style="{StaticResource QuickCommandActionButtonStyle}"
                                                    MinWidth="0"
                                                    MinHeight="0"
                                                    Padding="0"
                                                    ToolTip="开始或停止快捷参数循环发送"
                                                    ToolTipService.ShowOnDisabled="True"
                                                    ToolTipService.InitialShowDelay="200"
                                                    ToolTipService.ShowDuration="5000"
                                                    Command="{Binding DataContext.ToggleQuickParameterRepeatCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}">
                                                <ui:SymbolIcon>
                                                    <ui:SymbolIcon.Style>
                                                        <Style TargetType="ui:SymbolIcon" BasedOn="{StaticResource QuickCommandActionIconStyle}">
                                                            <Setter Property="Symbol" Value="ArrowRepeatAll20" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsParameterRepeating}" Value="True">
                                                                    <Setter Property="Symbol" Value="Pause20" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </ui:SymbolIcon.Style>
                                                </ui:SymbolIcon>
                                            </Button>
                                            <TextBox Grid.Column="4"
                                                     Width="50"
                                                     Height="26"
                                                     MinHeight="0"
                                                     Margin="0"
                                                     Padding="0"
                                                     FontSize="10"
                                                     HorizontalContentAlignment="Center"
                                                     VerticalContentAlignment="Center"
                                                     TextAlignment="Center"
                                                     MaxLength="5"
                                                     Validation.ErrorTemplate="{x:Null}"
                                                     Text="{Binding ParameterRepeatIntervalText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                     LostKeyboardFocus="OnQuickParameterRepeatIntervalLostKeyboardFocus"
                                                     ToolTip="快捷参数循环发送间隔，范围 10~60000 ms" />
                                            <TextBlock Grid.Column="5"
                                                       Margin="4,0,6,0"
                                                       HorizontalAlignment="Left"
                                                       VerticalAlignment="Center"
                                                       FontSize="10"
                                                       Foreground="{DynamicResource MutedTextBrush}"
                                                       Text="ms" />
                                            </Grid>
                                        </Border>
                                    </Grid>
                                    </Border>
                                </ScrollViewer>
                            </Grid>
                        </Border>

                        <Button x:Name="QuickCommandEditorCollapseButton"
                                Width="52"
                                Height="18"
                                MinHeight="18"
                                Padding="0"
                                Margin="0"
                                Panel.ZIndex="2"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Top"
                                Style="{StaticResource RoundedButtonStyle}"
                                ToolTip="收起指令编辑器"
                                Click="OnCollapseQuickCommandEditorClick">
                            <ui:SymbolIcon Symbol="ChevronDown20" Width="13" Height="13" FontSize="13" />
                        </Button>
                    </Grid>

                </Grid>
            </Border>
        </Grid>

        <Border Grid.Row="3"
                Padding="8,0"
                Background="{DynamicResource PanelBackgroundBrush}"
                BorderBrush="{DynamicResource DividerBrush}"
                BorderThickness="0,1,0,0">
            <DockPanel LastChildFill="True">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Margin="10,0" FontSize="11" Foreground="{DynamicResource ButtonForegroundBrush}" Text="{Binding RateText}" />
                    <TextBlock Margin="10,0" FontSize="11" Foreground="{DynamicResource ReceiveBrush}" Text="{Binding ReceivedBytes, StringFormat=RX {0:N0}}" />
                    <TextBlock Margin="10,0" FontSize="11" Foreground="{DynamicResource SendBrush}" Text="{Binding SentBytes, StringFormat=TX {0:N0}}" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse Width="7" Height="7" Margin="0,0,6,0">
                        <Ellipse.Style>
                            <Style TargetType="Ellipse">
                                <Setter Property="Fill" Value="#8B9690" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsConnected}" Value="True">
                                        <Setter Property="Fill" Value="#20A36A" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Ellipse.Style>
                    </Ellipse>
                    <TextBlock FontSize="11" Text="{Binding StatusText}" TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </DockPanel>
        </Border>

        <Grid x:Name="ThemeTransitionOverlay"
              Grid.Row="0"
              Grid.RowSpan="4"
              Panel.ZIndex="1000"
              ClipToBounds="True"
              IsHitTestVisible="False"
              Visibility="Collapsed">
            <Border x:Name="DarkThemeWipe"
                    Width="0"
                    HorizontalAlignment="Center"
                    Background="#181B1A" />
            <Border x:Name="LightThemeLeftWipe"
                    Width="0"
                    HorizontalAlignment="Left"
                    Background="#F4F6F4" />
            <Border x:Name="LightThemeRightWipe"
                    Width="0"
                    HorizontalAlignment="Right"
                    Background="#F4F6F4" />
        </Grid>
    </Grid>
</ui:FluentWindow>
