      "Parameters": [
        { "Name": "freq_ghz", "Type": "number", "Required": true, "Min": 9.29, "Max": 11.59, "Unit": "GHz" },
        { "Name": "pwr", "Type": "integer", "Required": false, "Default": 30, "Min": 0, "Max": 63, "Unit": "LMX2595 power code" }
      ],
      "SuccessResponse": "$<freq_ghz with 6 decimals>GHz\\r\\n",
      "ErrorResponses": ["$>ERR,ARG\\r\\n", "$>ERR,RANGE\\r\\n", "$>ERR,LOCK\\r\\n"],
      "Notes": ["参数是 LMX2595 本振 GHz，不是业务 RF MHz。", "配置成功后保存频率/功率并更新 PD14。"],
      "SourceLine": 766
