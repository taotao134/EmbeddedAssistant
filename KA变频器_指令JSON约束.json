  "GenerationRules": {
    "OutputOneFilePerTransport": false,
    "SerialAndUdpUseTheSamePayloads": true,
    "SingleFileContainsBothTransportCategories": true,
    "DefaultWorkspaceMode": "Serial",
    "PayloadMustNotContainLineEnding": true,
    "CommandLineEnding": "CRLF",
    "TextEncoding": "ASCII",
    "IsHex": false,
    "Checksum": "None",
    "ChecksumLittleEndian": true,
    "TemplateEqualsPayloadWhenNoVariables": true,
    "VariableTemplate": {
    "Syntax": "${name} 或 &{name}",
    "NamePattern": "^[\\p{L}\\p{Nl}_][\\p{L}\\p{Nl}\\p{M}\\p{N}_]*$",
      "PayloadUsesConcreteValues": true,
      "TemplateUsesVariables": true,
      "VariableValuesLocation": "Use Variables for one editable default set; use VariableSets for selectable presets and set SelectedVariableSetId to one valid set.",
      "ClosingBraceRequired": true
    },
    "UseConcreteValidExamplesByDefault": true,
    "UseUniqueGuidForEveryProfileAndCommand": true,
    "IncludeUnimplementedCommandsByDefault": false,
    "IncludeCompatibilityRejectedCommands": false,
    "IncludeDeviceToDisplayEventsAsHostCommands": false,
    "CommandGroupCategory": {
      "Serial": "Serial",
      "Udp": "Tcp"
    },
    "SafetyRules": [
      "命令关键字、大小写、逗号位置和参数顺序必须保持源码原样。",
      "所有参数先使用合法示例值；不要为了展示范围而生成空字段或尾随逗号。",
      "频率、功率和衰减命令必须使用源码允许的单位与范围。",
      "网络参数命令只生成四段 0~255 的合法 IPv4 示例。",
      "被标记为 compatibility_rejected 的命令不生成到默认导入文件；需要回归测试时只能由用户显式单独生成。",
      "legacy_placeholder 和 unimplemented 命令不放入默认可发送分组；需要回归旧协议时再显式生成。",
      "不要把 UDP 的请求回显伪造成设备响应；回显由固件 net_task 自动发送。"
    ],
    "CodexWorkflow": [
      "先读取用户指定工程的 proc_cmd.c、对应头文件和协议文档。",
      "逐个确认命令是否存在于实际解析分支；宏存在但没有分支的命令标记为 unimplemented。",
      "为每个命令生成 Name、Payload、Template、参数说明、成功响应和错误响应。",
      "只生成一个单对象 JSON，默认 WorkspaceMode=Serial、Transport 使用 serial；CommandGroups 同时包含 Category=Serial 和 Category=Tcp 两组，且两组 Payload 集合完全一致。",
      "用户切换到 Network 工作页后，软件会自动选择 Tcp 快捷指令分类；用户再在网络传输设置中选择 Udp 并填写设备端点。",
      "生成后用 JSON 解析器校验，并检查每个 Payload 都符合本文件的 CommandDefinitions。"
    ]
  },
  "TransportProfiles": {
    "Serial": {
      "WorkspaceMode": "Serial",
      "CommandCategory": "Serial",
      "Transport": {
        "$type": "serial",
        "PortName": "",
        "BaudRate": 115200,
        "DataBits": 8,
        "Parity": "None",
        "StopBits": "One",
        "Handshake": "None",
        "DtrEnable": false,
        "RtsEnable": false,
        "Kind": "Serial",
        "AutoReconnect": false
      },
      "Notes": [
        "USART1 和 USART3 均为 115200, 8N1。",
        "串口接收以 LF 结束，推荐上位机发送 CRLF；串口只返回处理结果，不回显请求。",
        "PortName 留空，导入后在当前软件里选择实际 COM 口。"
      ]
    },
    "Udp": {
      "WorkspaceMode": "Network",
      "CommandCategory": "Tcp",
      "Transport": {
        "$type": "udp",
        "LocalAddress": "0.0.0.0",
        "LocalPort": 777,
        "RemoteAddress": "192.168.1.10",
        "RemotePort": 10071,
        "EnableBroadcast": false,
        "MulticastAddress": null,
        "Kind": "Udp",
        "AutoReconnect": false
      },
      "Notes": [
        "设备监听 UDP 10071；当前软件本地端口使用 777。",
        "UDP 每次只发送一条完整命令；设备先回显原始请求，再发送处理结果，两者是两个 UDP 数据报。",
        "RemoteAddress 应按现场设备 IP 修改，默认值来自当前工程和桌面样例。"
      ]
    }
  },
  "Protocol": {
    "CommandPrefix": "$",
    "ParameterSeparator": ",",
    "CaseSensitive": true,
    "DefaultLineEnding": "CRLF",
    "DefaultEncoding": "ASCII",
    "Checksum": "None",
    "MaxUdpReceiveBytes": 1499,
    "SerialInputs": [
      "USART1：站控/后端串口命令入口。",
      "USART3：显示板 USART2 的主控侧命令入口，也会调用同一个 proc_cmd()。"
    ],
    "ResponseTransportDifference": {
      "Serial": "只发送 proc_cmd() 生成的结果。",
      "Udp": "先发送原始请求回显，再发送 proc_cmd() 生成的结果。"
    },
    "CommonResponses": {
      "Ok": "$>OK\\r\\n",
      "ArgError": "$>ERR,ARG\\r\\n",
      "RangeError": "$>ERR,RANGE\\r\\n",
      "LockError": "$>ERR,LOCK\\r\\n",
      "InternalError": "$>ERR,INTERNAL\\r\\n",
      "BusyError": "$>ERR,BUSY\\r\\n"
    },
    "MatchingCaveat": "proc_cmd.c 使用 strstr()，因此上位机必须发送精确的单条命令，不能依赖前缀边界或把多条命令拼成一帧。"
  },
  "CommandDefinitions": [
